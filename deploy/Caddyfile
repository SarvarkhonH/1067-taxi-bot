# 1067/BirJoy — Caddy konfiguratsiyasi. O'rni: /etc/caddy/Caddyfile
# "birjoy.online" so'zini real domenga almashtiring (setup.sh buni o'zi qiladi).
# HTTPS sertifikatlar avtomatik (Let's Encrypt) — DNS A-yozuvlar to'g'ri bo'lsa bas.
# Tekshirish: caddy validate --config /etc/caddy/Caddyfile ; systemctl reload caddy
#
# TEZLIK (2026-07-25 o'lchovi): server ichida javob 2-5ms, lekin O'zbekistondan
# masofa ~126ms RTT. Shuning uchun har ORTIQCHA so'rov = +126ms. Ikki chora:
#   1. zstd/br siqish (gzip'dan ~20% kichik) — kamroq bayt, kamroq vaqt.
#   2. Kesh sarlavhalari — Vite fayl nomlariga hash qo'yadi (index-CNa_0bce.js),
#      ya'ni mazmun o'zgarsa NOM o'zgaradi. Demak /assets/* ni 1 yil keshlash
#      XAVFSIZ va takroriy ochishda 0 ta so'rov qoldiradi. index.html esa
#      HAR DOIM qayta tekshiriladi (aks holda yangi deploy ko'rinmay qoladi).

api.birjoy.online {
	reverse_proxy localhost:8080
	encode zstd gzip
}

app.birjoy.online {
	root * /var/www/miniapp
	encode zstd gzip

	# Hash'li fayllar — mazmun o'zgarsa nomi o'zgaradi → abadiy keshlash xavfsiz.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html — hech qachon keshlanmaydi, aks holda yangi versiya chiqmaydi.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}

admin.birjoy.online {
	root * /var/www/admin
	encode zstd gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@html path / /index.html
	header @html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
