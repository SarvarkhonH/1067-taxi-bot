# 1067/BirJoy — Caddy konfiguratsiyasi. O'rni: /etc/caddy/Caddyfile
# "birjoy.online" so'zini real domenga almashtiring (setup.sh buni o'zi qiladi).
# HTTPS sertifikatlar avtomatik (Let's Encrypt) — DNS A-yozuvlar to'g'ri bo'lsa bas.
# Tekshirish: caddy validate --config /etc/caddy/Caddyfile ; systemctl reload caddy
#
# TEZLIK (2026-07-25 o'lchovi): server ichida javob 2-5ms, lekin O'zbekistondan
# masofa ~126ms RTT. Shuning uchun har ORTIQCHA so'rov = +126ms. Ikki chora:
#   1. zstd/br siqish (gzip'dan ~20% kichik) — kamroq bayt, kamroq vaqt.
#   2. Kesh sarlavhalari — Vite fayl nomlariga hash qo'yadi (index-CNa_0bce.js),
#      ya'ni mazmun o'zgarsa NOM o'zgaradi. Demak /assets/* ni 1 yil keshlash
#      XAVFSIZ va takroriy ochishda 0 ta so'rov qoldiradi. index.html esa
#      HAR DOIM qayta tekshiriladi (aks holda yangi deploy ko'rinmay qoladi).

api.birjoy.online {
	log
	# Deploy paytida bot ~2-3s ga qayta ishga tushadi. lb_try_duration'siz Caddy o'sha
	# oynada 502 qaytarardi — mijoz uchun "server o'chdi" ko'rinardi. Endi so'rov 15s gacha
	# kutadi va bot ko'tarilishi bilan bajariladi: deploy mijozga sezilmaydi.
	reverse_proxy localhost:8080 {
		lb_try_duration 15s
		lb_try_interval 300ms
	}
	encode zstd gzip
}

app.birjoy.online {
	log
	root * /var/www/miniapp
	encode zstd gzip

	# Hash'li fayllar — mazmun o'zgarsa nomi o'zgaradi → abadiy keshlash xavfsiz.
	# /assets/* — Vite hash'li fayllar. MAVJUD bo'lsa 1 yil kesh; YO'Q bo'lsa 404.
	# SPA-fallback bu blokda ATAYLAB yo'q. Avval try_files /assets/* ga ham tegardi:
	# eski index.html ushlab qolgan mijoz yo'q chunk so'raganda 200 + index.html olardi
	# (Content-Type: text/html) -> brauzer JS o'rniga HTML ko'rib modulni ISHGA TUSHIRMASDI
	# -> abadiy oq ekran, va o'sha buzuq javob immutable bo'lgani uchun 1 YILGA keshlanardi.
	# Endi 404 qaytadi - Vite'ning vite:preloadError self-heal'i uni ushlab qayta yuklaydi.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# ⚠️ XATO JAVOBLAR KESHLANMAYDI (2026-07-28). Yuqoridagi `header` butun `handle` blokiga
	# tegishli — ya'ni 404 ham `immutable, 1 yil` bilan qaytardi. Deploy paytidagi poygada bitta
	# 404 olgan mijoz uchun o'sha chunk BIR YILGA yo'q bo'lib qolardi. Endi xato javob
	# `no-store` bilan ketadi va keyingi urinishda qayta so'raladi.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# index.html — hech qachon keshlanmaydi, aks holda yangi versiya chiqmaydi.
	# Har qanday HTML — bosh sahifa ham, /ravella kabi mustaqil sahifalar ham — HAR DOIM
	# qayta tekshiriladi. Avval faqat "/" va "/index.html" yozilgandi: /ravella/ sahifasi
	# Cache-Control'siz ketardi va brauzer uni jimgina keshlab, yangi deploy ko'rinmasdi.
	handle {
		@html path / /index.html /*/index.html /ravella /ravella/
		header @html Cache-Control "no-cache"

	# {path}/index.html — katalog ichidagi mustaqil sahifalar (masalan /ravella) SPA fallback'ga
	# tushib ketmasin; SPA fallback oxirgi bo'lib qoladi.
		try_files {path} {path}/index.html /index.html
		file_server
	}
}

admin.birjoy.online {
	log
	root * /var/www/admin
	encode zstd gzip

	# /assets/* — Vite hash'li fayllar. MAVJUD bo'lsa 1 yil kesh; YO'Q bo'lsa 404.
	# SPA-fallback bu blokda ATAYLAB yo'q. Avval try_files /assets/* ga ham tegardi:
	# eski index.html ushlab qolgan mijoz yo'q chunk so'raganda 200 + index.html olardi
