	# {path}/index.html — katalog ichidagi mustaqil sahifalar (masalan /ravella) SPA fallback'ga
	# tushib ketmasin; SPA fallback oxirgi bo'lib qoladi.
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
