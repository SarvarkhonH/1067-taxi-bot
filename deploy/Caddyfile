	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Har qanday HTML — bosh sahifa ham, /ravella kabi mustaqil sahifalar ham — HAR DOIM
	# qayta tekshiriladi. Avval faqat "/" va "/index.html" yozilgandi: /ravella/ sahifasi
	# Cache-Control'siz ketardi va brauzer uni jimgina keshlab, yangi deploy ko'rinmasdi.
	handle {
		@html path / /index.html /*/index.html /ravella /ravella/
