// kas1067 already computes the numbers; this schema mirrors them and adds the
// gamification layer. A "member" is either a client (passenger loyalty bonus)
// or a driver (account balance / earnings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" // Neon (eu-central-1, doim-yoqiq) — 2026-06-13 da Render'dan ko'chirildi
  url       = env("DATABASE_URL") // runtime: POOLED ulanish (ko'p ulanishni ko'taradi)
  directUrl = env("DIRECT_URL") // migratsiya/db push: DIRECT ulanish (pooler'siz)
}

model Member {
  id         Int       @id @default(autoincrement())
  type       String // "client" | "driver"
  kasId      String // external id from kas1067 (unique within a type)
  fullName   String
  phone      String?
  carNumber  String? // drivers only
  points     Float     @default(0) // bonus (client) | balance (driver) — RIDE cashback, mirrored from kas1067
  coins      Float     @default(0) // GAME currency (1 coin = 1 so'm), lives only in our DB
  trips      Int       @default(0)
  rating     Float     @default(0) // drivers only
  active     Boolean   @default(true)
  lastSyncAt DateTime?
  lastBookingId     Int?
  lastBookingStatus String?
  lastBookingCar    String? // car number of the ride in progress → tip target on finish
  lastBookingBonus  Float? // fare-derived cashback captured DURING the ride (kas drops it on finish)
  lastBookingSource String? // "bot" | "miniapp" — E-gate channel share metric
  comboBoostDay     String? // tashkent day the daily combo earned a 2x roll for
  comebackOfferUntil DateTime?
  plusUntil          DateTime? // win-back: guaranteed 3x roll window
  // live ride card (ONE message per ride, edited in place) + moving driver pin
  rideCardMsgId     Int?
  liveLocMsgId      Int?
  rideStartedAt     DateTime? // first sweep sighting of status "started" — ride meter (guess + garage)
  riskFlag          Boolean @default(false) // freezes the withdraw door only; coins stay spendable
  riskNote          String?
  // 1-tap booking: persisted pickup memory (in-memory Map died on every deploy)
  defaultPickupId   Int?
  defaultPickupName String?
  lastPickupId      Int?
  lastPickupName    String?
  lastPickupLat     Float?
  lastPickupLng     Float?
  lastBookingAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  telegramUser TelegramUser?
  achievements MemberAchievement[]
  rewardGrants RewardGrant[]
  streak       Streak?
  wheelSpins   WheelSpin[]
  missions     MissionProgress[]
  boxOpens     BoxOpen[]
  weeklyScores WeeklyScore[]
  coinTxns     CoinTxn[]
  withdrawals  Withdrawal[]
  leagueTier   String        @default("Bronza") // promotion/relegation tier
  driverTier   String        @default("Bronza") // weekly driver tier (DiDi model): Bronza|Kumush|Oltin|Olmos

  @@unique([type, kasId])
  @@index([type, points])
  @@index([type, carNumber]) // T2: driver-by-car lookup in ride finish (AUDIT 2.4)
  @@index([phone]) // T2: endsWith phone lookups — corp/transfer/360 (AUDIT 2.5)
}

// Daily/weekly quests. Definitions live in shared/missions.ts; this tracks
// per-member progress within a period (tashkent day or ISO week).
model MissionProgress {
  id        Int       @id @default(autoincrement())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  code      String // mission code from the shared catalog
  periodKey String // "2026-06-09" (daily) | "2026-W24" (weekly)
  progress  Int       @default(0)
  claimedAt DateTime? // set when the reward is collected
  updatedAt DateTime  @updatedAt

  @@unique([memberId, code, periodKey])
  @@index([memberId])
}

// Completed referrals (one credited row per invitee). Telegram-id based so it
// works before the inviter/invitee are even linked to a kas member.
// Anti-sybil: the referee gift pays on link; the REFERRER reward is deferred
// until the referee completes a real paid ride (referrerPaidAt marks it).
model Referral {
  id              Int      @id @default(autoincrement())
  referrerId      String // telegram id of the inviter
  refereeId       String   @unique // telegram id of the invitee — one credit each
  refereeMemberId Int?
  rewardReferrer  Float    @default(0)
  rewardReferee   Float    @default(0)
  referrerPaidAt  DateTime? // set when the referrer reward is actually granted (first referee ride)
  createdAt       DateTime @default(now())

  @@index([referrerId])
}

// 💎 Kolleksiya: DB-backed numbered collectibles (no blockchain, no "NFT"
// word). Scarcity = immutable mintCap (no admin restock route exists), value =
// serial + display + internal resale (10% burn).
model ItemType {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  emoji       String @default("💎")
  series      String @default("launch")
  rarity      String @default("oddiy") // oddiy | kam | nodir | afsonaviy
  kind        String // plate | badge | trophy | ticket | part | car
  mintCap     Int    @default(0) // 0 = unlimited (drop kinds)
  mintPrice   Float  @default(0) // 0 = drop-only, not buyable
  mintedCount Int    @default(0)
}

model Item {
  id         Int      @id @default(autoincrement())
  itemTypeId Int
  serial     Int
  ownerId    Int
  acquiredAt DateTime @default(now())

  @@unique([itemTypeId, serial])
  @@index([ownerId])
}

// "Sotuvda" shelf — internal resale market (escrow-by-ownership: the listing
// locks the item; buy = atomic ownership flip + 10% burn).
model ItemListing {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  sellerId  Int
  price     Float
  createdAt DateTime @default(now())
}

// 🚖 Driver-recruiter: rider joined via a driver's in-car QR.
model DriverRecruit {
  id            Int      @id @default(autoincrement())
  driverId      Int
  riderMemberId Int      @unique
  createdAt     DateTime @default(now())

  @@index([driverId])
}

// 🔔 Push engine log: one row per (member, trigger-kind, day) — the dedupe
// that enforces "max 2 pushes/day, never the same trigger twice".
model NotifyLog {
  id       Int      @id @default(autoincrement())
  memberId Int
  kind     String // streak_saver | lucky_day | jackpot | comeback | garage_service | recap
  dayKey   String
  sentAt   DateTime @default(now())

  @@unique([memberId, kind, dayKey])
  @@index([memberId, dayKey])
}

// 🚗 Garaj: owned ride-to-earn cars. One equipped car earns during real rides.
model MemberCar {
  id                Int      @id @default(autoincrement())
  memberId          Int
  carCode           String
  isEquipped        Boolean  @default(false)
  ridesSinceService Int      @default(0)
  boughtAt          DateTime @default(now())

  @@unique([memberId, carCode])
  @@index([memberId])
}

// ⏱ ETA-guess: rider predicts the ride duration range at start; checked at
// finish against the server-side ride meter. One guess per ride.
model RideGuess {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  guessBand String // "<6" | "6-9" | "10-14" | "15+"
  won       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
}

// 🎲 Variable ride-cashback roll (the book's 80/15/4/1) — one idempotent row
// per real completed ride; grants COINS (never direct kas money).
model RideReward {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  tier      String // standard | double | triple | jackpot
  amount    Float
  lucky     Boolean  @default(false) // lucky-day doubling applied
  source    String   @default("bot") // booking channel (bot | miniapp)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([memberId, createdAt])
  @@index([createdAt]) // T2: cross-member monthly counts — corp/gap (AUDIT 2.11)
}

// In-ride wheel: ONE spin per real ride (bookingId), only while the booking is
// in "started". Paid respins were removed (UZ gambling posture).
model WheelSpin {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day (stats)
  bookingId Int? // the real ride this spin belongs to (null = legacy daily spins)
  prize     String
  amount    Float    @default(0)
  paid      Boolean  @default(false) // legacy respin flag (no new paid spins)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([memberId, dayKey])
}

// ── 🏪 Bozor: spendable-cashback marketplace ──────────────────────────────────
// Local shops list goods priced in coins; buying BURNS the buyer's coins and
// issues a voucher code the shop redeems in person. MVP is ABSORB-only: the
// shop honors the voucher as its own discount/marketing — costs us 0 real
// money. (Cash settlement / REDEEM mode is a later, separately-budgeted phase.)
model Shop {
  id        Int       @id @default(autoincrement())
  name      String
  emoji     String    @default("🏪")
  category  String    @default("boshqa") // oziq-ovqat | xizmat | do'kon | boshqa
  ownerPhone String? // verified owner phone (redeems vouchers)
  status    String    @default("active") // active | paused
  // settlement trust ladder: every shop starts ABSORB (0 cash risk); admin may
  // promote to REDEEM (weekly cash settle at spread, bozor-budget gated)
  settlementMode String  @default("absorb") // absorb | redeem
  spread         Float   @default(0.12) // our take on REDEEM settlements
  dailyCapCoins  Float   @default(100000) // max coin volume the shop can take per day
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id           Int     @id @default(autoincrement())
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId       Int
  title        String
  emoji        String  @default("🎁")
  priceCoins   Float
  perUserLimit Int     @default(3) // anti-wash: max purchases per member per listing
  active       Boolean @default(true)

  @@index([shopId, active])
}

// Escrowed purchase: coins are burned at buy time; the voucher is the durable
// claim the buyer shows at the shop. Idempotent redeem via status flip.
model ShopOrder {
  id           Int       @id @default(autoincrement())
  shopId       Int
  listingId    Int
  buyerMemberId Int
  priceCoins   Float
  voucherCode  String    @unique // 6-char code shown at the counter
  status       String    @default("issued") // issued | redeemed | expired
  createdAt    DateTime  @default(now())
  redeemedAt   DateTime?
  settledAt    DateTime? // REDEEM-mode: when the weekly cash settle covered this order

  @@index([buyerMemberId, createdAt])
  @@index([shopId, status])
}

// P2P coin movement (client<->client, client->driver tip). Coins MOVE, never
// mint: paired CoinTxn rows (-amount / +net) in one transaction keep the
// reconciliation invariant per member; the burn shrinks total supply.
model Transfer {
  id             Int      @id @default(autoincrement())
  fromMemberId   Int
  toMemberId     Int
  amount         Float // debited from sender
  burn           Float    @default(0) // destroyed (anti-wash); receiver gets amount-burn
  note           String?
  kind           String   @default("transfer") // transfer | tip
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([fromMemberId, createdAt])
  @@index([toMemberId, createdAt])
}

// Game-currency ledger. Every coin movement (earn +, spend/withdraw -) is one
// row; Member.coins is the denormalized running balance.
model CoinTxn {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // + earn, - spend/withdraw
  kind           String // streak|wheel|mission|box|weekly|surprise|referral|respin|premium_box|withdraw (+ historical arcade kinds race|duel|park|quiz|crash — immutable audit rows, never delete)
  reason         String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

// Coin -> real so'm conversions (the ONLY place real money leaves the system).
model Withdrawal {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  amount     Float
  kasApplied Boolean  @default(false)
  kasMessage String?
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
}

// Weekly engagement league: score accrues from bot actions (check-in, spin,
// missions, rides, referrals); top-3 of the closed week win real cashback.
model WeeklyScore {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  weekKey   String // ISO week, e.g. "2026-W24"
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([weekKey, score])
}

// Tiny global key-value state (jackpot pool, weekly-payout markers).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// T7/T8 — local daily ride rollup (Tashkent day). Fed by the sync tick from kas's
// shallow-but-complete "today" window, so week-over-week / 7-day metrics come from
// our own DB instead of impractically deep kas paging (~1650 report rows/day).
model DailyStat {
  day            String   @id // YYYY-MM-DD (Tashkent, UTC+5)
  completedRides Int      @default(0)
  cancelledRides Int      @default(0)
  botRides       Int      @default(0)
  gmv            Float    @default(0) // gross fares (so'm) of completed rides
  updatedAt      DateTime @updatedAt
}

// Mystery box: free one unlocks by completing ALL daily missions (once/day);
// premium boxes are bought with coins, unlimited.
model BoxOpen {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day
  prize     String
  amount    Float    @default(0)
  premium   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memberId, dayKey])
}

// Every cashback we grant (idempotent + audited — this writes REAL money to kas1067).
model RewardGrant {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // so'm granted
  reason         String // human label, e.g. "Streak 7 kun"
  kind           String // streak | wheel | challenge | referral | manual
  appliedToKas   Boolean  @default(false)
  kasMessage     String?
  idempotencyKey String?  @unique // blocks double-grants (e.g. "streak:42:2026-06-09")
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

model Streak {
  id          Int       @id @default(autoincrement())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int       @unique
  current     Int       @default(0)
  longest     Int       @default(0)
  lastCheckIn DateTime? // last daily check-in (date)
  updatedAt   DateTime  @updatedAt
}

model TelegramUser {
  id           String    @id // telegram user id, stored as string to avoid BigInt JSON issues
  member       Member?   @relation(fields: [memberId], references: [id])
  memberId     Int?      @unique
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  languageCode String?
  isAdmin      Boolean   @default(false)
  linkedAt     DateTime?
  referralCode       String?   @unique // this user's own invite code
  referredByCode     String? // pending invite code captured at /start
  referralCreditedAt DateTime? // set once the referral reward is paid (one-time)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MemberAchievement {
  id       Int      @id @default(autoincrement())
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int
  code     String // badge code from the shared catalog
  earnedAt DateTime @default(now())
  notified Boolean  @default(false)

  @@unique([memberId, code])
}

model SyncRun {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running") // running | ok | error
  source      String    @default("mock") // mock | live
  membersSeen Int       @default(0)
  message     String?
}

// 👬 Gap (o'zbekona jamoa): 3-6 do'st, haftalik jamoa maqsadi, rotatsion pot.
model Gap {
  id        Int         @id @default(autoincrement())
  name      String
  code      String      @unique
  creatorId Int
  potIndex  Int         @default(0)
  createdAt DateTime    @default(now())
  members   GapMember[]
}

model GapMember {
  id       Int      @id @default(autoincrement())
  gapId    Int
  memberId Int      @unique // one gap per member
  joinedAt DateTime @default(now())
  gap      Gap      @relation(fields: [gapId], references: [id])

  @@index([gapId])
}

// 🏢 B2B prepaid corp accounts: phone-whitelisted employees ride, balance prepaid in coins.
model CorpAccount {
  id        Int            @id @default(autoincrement())
  name      String
  balance   Float          @default(0)
  monthlyCapPerEmployee Int @default(30)
  createdAt DateTime       @default(now())
  employees CorpEmployee[]
}

model CorpEmployee {
  id     Int         @id @default(autoincrement())
  corpId Int
  phone  String      @unique // last-9 normalized
  name   String?
  corp   CorpAccount @relation(fields: [corpId], references: [id])

  @@index([corpId])
}

// ⭐ E7: post-ride rating + quick tags ("Toza mashina")
model RideRating {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  carNumber String   @default("")
  stars     Int
  tags      String   @default("")
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([carNumber])
}

// 🤝 Virtual bozor v2: escrowed offers (coins and/or barter) + per-deal chat.
model TradeOffer {
  id          Int            @id @default(autoincrement())
  itemId      Int // target item being asked for
  fromId      Int // offerer (coins escrowed on create)
  toId        Int // current owner
  offerCoins  Int            @default(0)
  offerItemId Int? // barter: item offered in exchange
  status      String         @default("open") // open|accepted|rejected|cancelled
  createdAt   DateTime       @default(now())
  messages    TradeMessage[]

  @@index([toId, status])
  @@index([fromId, status])
}

model TradeMessage {
  id        Int        @id @default(autoincrement())
  offerId   Int
  fromId    Int
  text      String
  createdAt DateTime   @default(now())
  offer     TradeOffer @relation(fields: [offerId], references: [id])

  @@index([offerId])
}

// ⏰ I.2: scheduled rides — we hold them and dispatch via the periodic tick.
model ScheduledRide {
  id          Int      @id @default(autoincrement())
  memberId    Int
  addressId   Int
  addressName String
  phone       String
  runAt       DateTime
  status      String   @default("pending") // pending|dispatched|cancelled|failed
  createdAt   DateTime @default(now())

  @@index([status, runAt])
  @@index([memberId])
}

// 👨‍👩‍👧 I.3: family booking targets (max 3, validated at create).
model FamilyMember {
  id       Int    @id @default(autoincrement())
  memberId Int
  phone    String
  name     String

  @@unique([memberId, phone])
}
