// kas1067 already computes the numbers; this schema mirrors them and adds the
// gamification layer. A "member" is either a client (passenger loyalty bonus)
// or a driver (account balance / earnings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Render Postgres (persistent — survives deploys)
  url      = env("DATABASE_URL")
}

model Member {
  id         Int       @id @default(autoincrement())
  type       String // "client" | "driver"
  kasId      String // external id from kas1067 (unique within a type)
  fullName   String
  phone      String?
  carNumber  String? // drivers only
  points     Float     @default(0) // bonus (client) | balance (driver) — RIDE cashback, mirrored from kas1067
  coins      Float     @default(0) // GAME currency (1 coin = 1 so'm), lives only in our DB
  trips      Int       @default(0)
  rating     Float     @default(0) // drivers only
  active     Boolean   @default(true)
  lastSyncAt DateTime?
  lastBookingId     Int?
  lastBookingStatus String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  telegramUser TelegramUser?
  achievements MemberAchievement[]
  rewardGrants RewardGrant[]
  streak       Streak?
  wheelSpins   WheelSpin[]
  missions     MissionProgress[]
  boxOpens     BoxOpen[]
  weeklyScores WeeklyScore[]
  coinTxns     CoinTxn[]
  withdrawals  Withdrawal[]
  leagueTier   String        @default("Bronza") // promotion/relegation tier

  @@unique([type, kasId])
  @@index([type, points])
}

// Daily/weekly quests. Definitions live in shared/missions.ts; this tracks
// per-member progress within a period (tashkent day or ISO week).
model MissionProgress {
  id        Int       @id @default(autoincrement())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  code      String // mission code from the shared catalog
  periodKey String // "2026-06-09" (daily) | "2026-W24" (weekly)
  progress  Int       @default(0)
  claimedAt DateTime? // set when the reward is collected
  updatedAt DateTime  @updatedAt

  @@unique([memberId, code, periodKey])
  @@index([memberId])
}

// Completed referrals (one credited row per invitee). Telegram-id based so it
// works before the inviter/invitee are even linked to a kas member.
model Referral {
  id              Int      @id @default(autoincrement())
  referrerId      String // telegram id of the inviter
  refereeId       String   @unique // telegram id of the invitee — one credit each
  refereeMemberId Int?
  rewardReferrer  Float    @default(0)
  rewardReferee   Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([referrerId])
}

model WheelSpin {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day — one FREE spin per day; paid respins unlimited
  prize     String
  amount    Float    @default(0)
  paid      Boolean  @default(false) // true = respin bought with coins
  createdAt DateTime @default(now())

  @@index([memberId, dayKey])
}

// Game-currency ledger. Every coin movement (earn +, spend/withdraw -) is one
// row; Member.coins is the denormalized running balance.
model CoinTxn {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // + earn, - spend/withdraw
  kind           String // streak|wheel|mission|box|weekly|surprise|referral|respin|premium_box|withdraw (+ historical arcade kinds race|duel|park|quiz|crash — immutable audit rows, never delete)
  reason         String
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

// Coin -> real so'm conversions (the ONLY place real money leaves the system).
model Withdrawal {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  amount     Float
  kasApplied Boolean  @default(false)
  kasMessage String?
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
}

// Weekly engagement league: score accrues from bot actions (check-in, spin,
// missions, rides, referrals); top-3 of the closed week win real cashback.
model WeeklyScore {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  weekKey   String // ISO week, e.g. "2026-W24"
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([weekKey, score])
}

// Tiny global key-value state (jackpot pool, weekly-payout markers).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Mystery box: free one unlocks by completing ALL daily missions (once/day);
// premium boxes are bought with coins, unlimited.
model BoxOpen {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day
  prize     String
  amount    Float    @default(0)
  premium   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memberId, dayKey])
}

// Every cashback we grant (idempotent + audited — this writes REAL money to kas1067).
model RewardGrant {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // so'm granted
  reason         String // human label, e.g. "Streak 7 kun"
  kind           String // streak | wheel | challenge | referral | manual
  appliedToKas   Boolean  @default(false)
  kasMessage     String?
  idempotencyKey String?  @unique // blocks double-grants (e.g. "streak:42:2026-06-09")
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

model Streak {
  id          Int       @id @default(autoincrement())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int       @unique
  current     Int       @default(0)
  longest     Int       @default(0)
  lastCheckIn DateTime? // last daily check-in (date)
  updatedAt   DateTime  @updatedAt
}

model TelegramUser {
  id           String    @id // telegram user id, stored as string to avoid BigInt JSON issues
  member       Member?   @relation(fields: [memberId], references: [id])
  memberId     Int?      @unique
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  languageCode String?
  isAdmin      Boolean   @default(false)
  linkedAt     DateTime?
  referralCode       String?   @unique // this user's own invite code
  referredByCode     String? // pending invite code captured at /start
  referralCreditedAt DateTime? // set once the referral reward is paid (one-time)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MemberAchievement {
  id       Int      @id @default(autoincrement())
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int
  code     String // badge code from the shared catalog
  earnedAt DateTime @default(now())
  notified Boolean  @default(false)

  @@unique([memberId, code])
}

model SyncRun {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running") // running | ok | error
  source      String    @default("mock") // mock | live
  membersSeen Int       @default(0)
  message     String?
}
