// kas1067 already computes the numbers; this schema mirrors them and adds the
// gamification layer. A "member" is either a client (passenger loyalty bonus)
// or a driver (account balance / earnings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" // Neon (eu-central-1, doim-yoqiq) — 2026-06-13 da Render'dan ko'chirildi
  url       = env("DATABASE_URL") // runtime: POOLED ulanish (ko'p ulanishni ko'taradi)
  directUrl = env("DIRECT_URL") // migratsiya/db push: DIRECT ulanish (pooler'siz)
}

model Member {
  id                 Int       @id @default(autoincrement())
  type               String // "client" | "driver"
  kasId              String // external id from kas1067 (unique within a type)
  fullName           String // mirrored from kas1067 (overwritten on every sync — NOT user-editable)
  displayName        String? // user's own chosen name (bot/Mini App edit); sync NEVER touches it → wins over fullName
  phone              String?
  carNumber          String? // drivers only
  points             Float     @default(0) // bonus (client) | balance (driver) — RIDE cashback, mirrored from kas1067
  coins              Float     @default(0) // GAME currency (1 coin = 1 so'm), lives only in our DB
  trips              Int       @default(0)
  rating             Float     @default(0) // drivers only
  active             Boolean   @default(true)
  lastSyncAt         DateTime?
  lastBookingId      Int?
  lastBookingStatus  String?
  lastBookingCar     String? // car number of the ride in progress → tip target on finish
  lastBookingBonus   Float? // fare-derived cashback captured DURING the ride (kas drops it on finish)
  lastBookingSource  String? // "bot" | "miniapp" — E-gate channel share metric
  comboBoostDay      String? // tashkent day the daily combo earned a 2x roll for
  comebackOfferUntil DateTime?
  // 🏅 Tier loyalty loop (feature "tierloyalty", DARK). ballPoints = GAME-only XP from
  // daily-task completion; decayable; NEVER money (separate from points/coins).
  ballPoints         Int       @default(0)
  lastActiveDay      String? // tashkent YYYY-MM-DD of last qualifying activity (ride or claimed mission)
  decayAppliedDay    String? // tashkent YYYY-MM-DD decay last applied (anti-yo-yo: once/day)
  plusUntil          DateTime? // win-back: guaranteed 3x roll window
  // live ride card (ONE message per ride, edited in place) + moving driver pin
  rideCardMsgId      Int?
  liveLocMsgId       Int?
  rideStartedAt      DateTime? // first sweep sighting of status "started" — ride meter (guess + garage)
  riskFlag           Boolean   @default(false) // freezes the withdraw door only; coins stay spendable
  riskNote           String?
  // 🎁 RESERVED (currently unused). Was a per-welcome trips snapshot; superseded on 2026-07-23 by the
  // simpler flat paid-out gate (MIN_RIDES_FOR_PAID on member.trips, enforced in withdraw + transfer).
  // Kept (nullable, all-NULL in prod) to avoid a live-DB column drop; safe to remove in a later push.
  welcomeLockTrips   Int?
  // 🚫 HARD ban — TOTAL lockout from the whole product (Telegram bot + Mini App API). Distinct from
  // riskFlag (which only freezes the cash door): a banned member cannot open the bot, book, play,
  // earn, spend or transfer at all. Enforced at both entry gates via an in-memory set (banService).
  banned             Boolean   @default(false)
  bannedAt           DateTime?
  bannedReason       String?
  // 📷 driver portrait — synced from this user's Telegram profile photo (file_id stays valid forever
  // for the bot that fetched it). Resolved to a fresh URL on demand by /api/driver-photo/:memberId
  // (Telegram file URLs themselves have short TTL — the file_id is the durable handle).
  photoFileId        String?
  // optional override — paste a permanent URL (Cloudinary etc.) if Telegram avatar isn't suitable.
  photoUrl           String?
  // a DRIVER-submitted photo awaiting admin approval (anti-abuse: random/inappropriate photos never
  // reach riders). On approve → moves to photoFileId; on reject → cleared. Drivers cannot delete the
  // APPROVED photo (no driver-side delete path); only admins can replace/clear it.
  photoPendingFileId String?
  // 1-tap booking: persisted pickup memory (in-memory Map died on every deploy)
  defaultPickupId    Int?
  defaultPickupName  String?
  lastPickupId       Int?
  lastPickupName     String?
  lastPickupLat      Float?
  lastPickupLng      Float?
  lastBookingAt      DateTime?
  // "Yana shu yo'l" (NEXT_LEVEL_PLAN 1.1): last 3 DISTINCT dispatched pickups, most-recent-first,
  // JSON-encoded SavedAddressView[] — home-screen 1-tap repeat-route chips. Dedup by id (real kas
  // catalog addresses) or by name (raw map pins, id=0). Separate from lastPickup* (single-slot,
  // used by callOneTapFor's cascade) — this is purely a display list for the Mini App chip row.
  recentPickupsJson  String?
  // 🏠 Mahalla bozori (V1.5): "uy" mahalla (doimiy) + safar-rejimi vaqtinchalik override. Loose FK
  // to Mahalla.id (Product.shopId naqshi) — no @relation, joined manually in mahallaService.
  mahallaId          Int?
  travelMahallaId    Int?
  travelMahallaSetAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  telegramUser  TelegramUser?
  achievements  MemberAchievement[]
  rewardGrants  RewardGrant[]
  streak        Streak?
  wheelSpins    WheelSpin[]
  missions      MissionProgress[]
  boxOpens      BoxOpen[]
  weeklyScores  WeeklyScore[]
  coinTxns      CoinTxn[]
  withdrawals   Withdrawal[]
  cashoutRequests CashoutRequest[] // 💵 real cash-out (tanga → card/home), owner-approved
  driverSession DriverSession? // Bosqich 2: kas /api/driverApp/* auth (drivers only)
  // 🚐 Intercity (nationwide shared-taxi) — additive, gated behind feature "intercity"
  intercityTrips       IntercityTrip[]            @relation("IntercityDriver")
  intercityBookings    IntercityBooking[]
  intercityEnrollments IntercityDriverEnrollment[]
  intercityCommissions IntercityCommissionDebt[]
  intercityPenalties   IntercityDriverPenalty[]
  intercityWaitEntries IntercityWaitEntry[]
  leagueTier   String              @default("Bronza") // promotion/relegation tier
  driverTier   String              @default("Bronza") // weekly driver tier (DiDi model): Bronza|Kumush|Oltin|Olmos
  shopPurchases ShopPurchase[] // 🛍 tanga shop purchases (feature "shop")
  foodOrders    FoodOrder[] // 🍽 restoran buyurtmalari (feature "restoran")

  @@unique([type, kasId])
  @@index([type, points])
  @@index([type, carNumber]) // T2: driver-by-car lookup in ride finish (AUDIT 2.4)
  @@index([phone]) // T2: endsWith phone lookups — corp/transfer/360 (AUDIT 2.5)
}

// Daily/weekly quests. Definitions live in shared/missions.ts; this tracks
// per-member progress within a period (tashkent day or ISO week).
model MissionProgress {
  id        Int       @id @default(autoincrement())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  code      String // mission code from the shared catalog
  periodKey String // "2026-06-09" (daily) | "2026-W24" (weekly)
  progress  Int       @default(0)
  claimedAt DateTime? // set when the reward is collected
  updatedAt DateTime  @updatedAt

  @@unique([memberId, code, periodKey])
  @@index([memberId])
}

// Completed referrals (one credited row per invitee). Telegram-id based so it
// works before the inviter/invitee are even linked to a kas member.
// Anti-sybil: the referee gift pays on link; the REFERRER reward is deferred
// until the referee completes a real paid ride (referrerPaidAt marks it).
model Referral {
  id              Int       @id @default(autoincrement())
  referrerId      String // telegram id of the inviter
  refereeId       String    @unique // telegram id of the invitee — one credit each
  refereeMemberId Int?
  rewardReferrer  Float     @default(0)
  rewardReferee   Float     @default(0)
  referrerPaidAt  DateTime? // set when the referrer reward is actually granted (first referee ride)
  createdAt       DateTime  @default(now())

  @@index([referrerId])
}

// 💎 Kolleksiya: DB-backed numbered collectibles (no blockchain, no "NFT"
// word). Scarcity = immutable mintCap (no admin restock route exists), value =
// serial + display + internal resale (10% burn).
model ItemType {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  emoji       String @default("💎")
  series      String @default("launch")
  rarity      String @default("oddiy") // oddiy | kam | nodir | afsonaviy
  kind        String // plate | badge | trophy | ticket | part | car
  mintCap     Int    @default(0) // 0 = unlimited (drop kinds)
  mintPrice   Float  @default(0) // 0 = drop-only, not buyable
  mintedCount Int    @default(0)
}

model Item {
  id         Int      @id @default(autoincrement())
  itemTypeId Int
  serial     Int
  ownerId    Int
  acquiredAt DateTime @default(now())

  @@unique([itemTypeId, serial])
  @@index([ownerId])
}

// "Sotuvda" shelf — internal resale market (escrow-by-ownership: the listing
// locks the item; buy = atomic ownership flip + 10% burn).
model ItemListing {
  id        Int      @id @default(autoincrement())
  itemId    Int      @unique
  sellerId  Int
  price     Float
  createdAt DateTime @default(now())
}

// 🚖 Driver-recruiter: rider joined via a driver's in-car QR.
model DriverRecruit {
  id            Int      @id @default(autoincrement())
  driverId      Int
  riderMemberId Int      @unique
  createdAt     DateTime @default(now())

  @@index([driverId])
}

// 🔔 Push engine log: one row per (member, trigger-kind, day) — the dedupe
// that enforces "max 2 pushes/day, never the same trigger twice".
model NotifyLog {
  id       Int      @id @default(autoincrement())
  memberId Int
  kind     String // streak_saver | lucky_day | jackpot | comeback | garage_service | recap
  dayKey   String
  sentAt   DateTime @default(now())

  @@unique([memberId, kind, dayKey])
  @@index([memberId, dayKey])
}

// 🚗 Garaj: owned ride-to-earn cars. One equipped car earns during real rides.
model MemberCar {
  id                Int      @id @default(autoincrement())
  memberId          Int
  carCode           String
  isEquipped        Boolean  @default(false)
  ridesSinceService Int      @default(0)
  level             Int      @default(1) // garage upgrade level (1..GARAGE_MAX_LEVEL) — scales earn rate
  boughtAt          DateTime @default(now())

  @@unique([memberId, carCode])
  @@index([memberId])
}

// ⏱ ETA-guess: rider predicts the ride duration range at start; checked at
// finish against the server-side ride meter. One guess per ride.
model RideGuess {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  guessBand String // "<6" | "6-9" | "10-14" | "15+"
  won       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
}

// 🎲 Variable ride-cashback roll (the book's 80/15/4/1) — one idempotent row
// per real completed ride; grants COINS (never direct kas money).
model RideReward {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  tier      String // standard | double | triple | jackpot
  amount    Float
  lucky     Boolean  @default(false) // lucky-day doubling applied
  source    String   @default("bot") // booking channel (bot | miniapp)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([memberId, createdAt])
  @@index([createdAt]) // T2: cross-member monthly counts — corp/gap (AUDIT 2.11)
}

// 🪙 Wait compensation (feature "waitcomp"): tanga paid for search time before a driver accepted,
// scaled by a grace→ceiling ramp and gated on active play (score>0). OUTSIDE the 350/ride clamp
// (rollRideCashback) — this is compensation for OUR failure to find a driver fast, not stacked
// cashback, so it has its own daily company-wide budget instead (see waitCompDailyBudget knob).
// Same idempotent-insert-first pattern as RideReward: unique row wins the race, a re-polled sweep
// grants nothing on the second attempt.
model WaitCompReward {
  id          Int      @id @default(autoincrement())
  memberId    Int
  bookingId   Int
  waitSeconds Int
  score       Int
  amount      Float
  dayKey      String // Tashkent YYYY-MM-DD, mirrors OfisLedger — cheap daily-budget aggregate
  createdAt   DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([dayKey])
}

// In-ride wheel: ONE spin per real ride (bookingId), only while the booking is
// in "started". Paid respins were removed (UZ gambling posture).
model WheelSpin {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day (stats)
  bookingId Int? // the real ride this spin belongs to (null = legacy daily spins)
  prize     String
  amount    Float    @default(0)
  paid      Boolean  @default(false) // legacy respin flag (no new paid spins)
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([memberId, dayKey])
}

// ── 🏪 Bozor: spendable-cashback marketplace ──────────────────────────────────
// Local shops list goods priced in coins; buying BURNS the buyer's coins and
// issues a voucher code the shop redeems in person. MVP is ABSORB-only: the
// shop honors the voucher as its own discount/marketing — costs us 0 real
// money. (Cash settlement / REDEEM mode is a later, separately-budgeted phase.)
model Shop {
  id             Int       @id @default(autoincrement())
  name           String
  emoji          String    @default("🏪")
  category       String    @default("boshqa") // oziq-ovqat | xizmat | do'kon | boshqa
  ownerPhone     String? // verified owner phone (redeems vouchers)
  status         String    @default("active") // active | paused
  // settlement trust ladder: every shop starts ABSORB (0 cash risk); admin may
  // promote to REDEEM (weekly cash settle at spread, bozor-budget gated)
  settlementMode String    @default("absorb") // absorb | redeem
  spread         Float     @default(0.12) // our take on REDEEM settlements
  dailyCapCoins  Float     @default(100000) // max coin volume the shop can take per day
  createdAt      DateTime  @default(now())
  listings       Listing[]
}

model Listing {
  id           Int     @id @default(autoincrement())
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId       Int
  title        String
  emoji        String  @default("🎁")
  priceCoins   Float
  perUserLimit Int     @default(3) // anti-wash: max purchases per member per listing
  active       Boolean @default(true)

  @@index([shopId, active])
}

// Escrowed purchase: coins are burned at buy time; the voucher is the durable
// claim the buyer shows at the shop. Idempotent redeem via status flip.
model ShopOrder {
  id            Int       @id @default(autoincrement())
  shopId        Int
  listingId     Int
  buyerMemberId Int
  priceCoins    Float
  voucherCode   String    @unique // 6-char code shown at the counter
  status        String    @default("issued") // issued | redeemed | expired
  createdAt     DateTime  @default(now())
  redeemedAt    DateTime?
  settledAt     DateTime? // REDEEM-mode: when the weekly cash settle covered this order

  @@index([buyerMemberId, createdAt])
  @@index([shopId, status])
}

// P2P coin movement (client<->client, client->driver tip). Coins MOVE, never
// mint: paired CoinTxn rows (-amount / +net) in one transaction keep the
// reconciliation invariant per member; the burn shrinks total supply.
model Transfer {
  id             Int      @id @default(autoincrement())
  fromMemberId   Int
  toMemberId     Int
  amount         Float // base — credited to the recipient IN FULL (commission is charged ON TOP of the sender)
  burn           Float    @default(0) // legacy anti-wash burn (0 now — superseded by commission)
  commission     Float    @default(0) // platform fee charged to the sender, on top of amount
  note           String?
  kind           String   @default("transfer") // transfer | tip | fare
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([fromMemberId, createdAt])
  @@index([toMemberId, createdAt])
}

// 💼 Platform commission revenue. Coins collected as the configurable transfer fee live
// OUTSIDE the member closed-loop (like a burn, but TRACKED as company income so the dashboard
// can show total earned). One row per commissioned transfer; transferId makes it idempotent.
model PlatformLedger {
  id         Int      @id @default(autoincrement())
  amount     Float // commission collected (coins)
  source     String // transfer | tip | fare
  transferId Int?     @unique
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Game-currency ledger. Every coin movement (earn +, spend/withdraw -) is one
// row; Member.coins is the denormalized running balance.
model CoinTxn {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // + earn, - spend/withdraw
  kind           String // streak|wheel|mission|box|weekly|surprise|referral|respin|premium_box|withdraw (+ historical arcade kinds race|duel|park|quiz|crash — immutable audit rows, never delete)
  reason         String
  idempotencyKey String?  @unique
  bookingId      Int? // perf audit B4: the ride this grant belongs to (ride-bound faucets set it) → the
  // ≤350/ride clamp reads it via @@index instead of an unindexed endsWith suffix scan of the ledger.
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([memberId, bookingId])
}

// 🛍 TANGA SHOP (feature "shop"): owner-listed real goods bought with tanga; owner-fulfilled by hand
// (delivery by his own drivers). NO lootboxes — deterministic price/product only.
// 🏪 BirJoy V1 (BAZAR_PLAN): sotuvchi-do'kon — Restaurant shakli, food-maydonlarsiz. Legacy
// Shop/Listing/ShopOrder (voucher-tizim qoldiqlari) ATAYLAB tegilmagan — bu YANGI, toza model.
// Do'kon #1 = «BirJoy o'z do'koni» (ega, migrateBirjoySeller.ts); har lokal do'kon o'z vitrinasi.
model MarketShop {
  id             Int      @id @default(autoincrement())
  name           String
  category       String   @default("boshqa")
  phone          String
  address        String?
  workHours      String? // "09:00-22:00" — restoran bilan bir xil Ochiq/Yopiq hisob
  deliveryText   String? // Tier-1 yetkazish-va'dasi kartada: "Bugun 14:00-18:00" / "Ertaga"
  deliveryFeeSom Int      @default(0)
  minOrderTanga  Int      @default(0)
  slaMinutes     Int      @default(15) // shu vaqt ichida javob bo'lmasa egaga alert (sweep)
  ownerChatId    String? // sotuvchining Telegram chat_id'si — buyurtma-kartalar shu yerga (null → ega)
  photoFileId    String? // do'kon-logo (tgUploadPhoto pipeline)
  photoUrl       String?
  active         Boolean  @default(false) // wizard DARK yaratadi; EGA yoqadi
  paused         Boolean  @default(false)
  sortOrder      Int      @default(0)
  avgRating      Float    @default(0) // V3'da sotuvchi-reyting keshi
  reviewCount    Int      @default(0)
  orderCount     Int      @default(0)
  story          String? // D2: "Biz haqimizda" — seller-tahrirlanadigan hikoya/tavsif matni
  announcement   String? // D2: Etsy-uslub bitta-qatorli e'lon (masalan "Bugun yangi partiya keldi")
  announcementAt DateTime? // e'lon oxirgi yangilangan vaqti
  neighborhood   String? // D2: erkin-matn mahalla-teg (legacy) — mahallaId bo'lsa Mahalla.name unga ustun keladi, aks holda shu matnga fallback
  shopKind       String   @default("bozor") // V1.5: "bozor" (butun shahar) | "mahalla" (faqat o'z mahallasiga tez yetkazish)
  mahallaId      Int? // V1.5: faqat shopKind="mahalla" bo'lganda to'ldiriladi — loose FK (Mahalla.id)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([shopKind, mahallaId, active])
}

// §10.1: rol-darajali audit-jurnal — do'kon-boshqaruv mutatsiyalari (kim/qachon/nima o'zgartirdi).
// Ko'lam ATAYLAB do'kon-admin sirtiga cheklangan (mahsulot/buyurtma/profil/pauza/ommaviy-e'lon) —
// butun admin-panelni (buyurtma/kampaniya/haydovchi-missiya va h.k.) qamrab olish alohida, kattaroq
// tiket bo'lardi; bu yerda §10.1'ning o'zi so'ragan ko'p-do'kon boshqaruv sirtiga mos.
model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  actorRole   String // "owner" | "shopseller:<shopId>" | "operator"
  actorTgId   String? // res.locals.telegramId (bo'lsa)
  action      String // "toggle_pause" | "edit_product" | "create_product" | "delete_product" | "update_profile" | "bulk_announcement"
  targetType  String // "shop" | "product"
  targetId    Int?
  detail      String? // qisqa inson-o'qiy oladigan tafsilot (masalan "narx 5000→6000")
  createdAt   DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

// 🏠 V1.5: mahalla bozori — kas1067 manzil-katalogidan (api/addresses/) tanlab olingan, ega
// tasdiqlagan 39 ta haqiqiy mahalla (seedMahalla.ts). lat/lng — GPS-eng-yaqin-mahalla taxmini uchun.
model Mahalla {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  lat       Float
  lng       Float
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// 🎠 D1: boshqariladigan kategoriya (Uzum-uslub ikonka-karusel) — erkin-string davri tugaydi.
// Ikonka = admin yuklagan rasm (file_id pipeline); rasm yo'q bo'lsa emoji fallback.
model CategoryDef {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // deep-link ?go=dokon&c=<slug>
  name        String
  emoji       String   @default("🛍") // ikonka-rasm bo'lmaganda katta-emoji
  iconFileId  String?
  iconUrl     String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([active, sortOrder])
}

// 🧺 V2 (BAZAR_PLAN): ko'p-satrli savat-buyurtma — FoodOrder shakli + tanga. Narx-SNAPSHOT
// itemsJson'da (keyingi narx-tahrir ta'sir qilmaydi); tanga BUY'da ushlanadi (CoinTxn `mkt:<id>`
// bitta tx'da stock-claim bilan); reject/cancel = flip+restock+refund (`mktrefund:<id>`) BITTA tx
// (V0.2 saboqlari tug'ma). Status: pending→accepted→delivering→delivered | rejected | cancelled.
model MarketOrder {
  id             Int       @id @default(autoincrement())
  memberId       Int
  shopId         Int
  shopName       String // snapshot
  itemsJson      Json // [{productId, name, qty, priceTanga}] — narx-snapshot
  itemsTotal     Int // tanga (=so'm)
  deliveryFee    Int       @default(0)
  total          Int
  payKind        String    @default("tanga") // "tanga" (buy'da ushlangan) | "cash" (yetkazganda)
  address        String
  contact        String
  note           String?
  status         String    @default("pending") // pending|accepted|delivering|delivered|rejected|cancelled
  rejectReason   String?
  slaAlertedAt   DateTime?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([memberId, createdAt])
  @@index([shopId, status])
  @@index([status, createdAt])
}

// 🔎 V1.4: nol-natija qidiruvlar — «nima qidirildi-topilmadi» ro'yxati egaga qaysi sotuvchini
// chaqirishni aytadi (xizmatlar ServiceRequest naqshi).
model MarketDemand {
  id        Int      @id @default(autoincrement())
  memberId  Int?
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 🧡 V2b: sevimlilar — ServiceFavorite naqshi, lekin memberId (shop-konventsiya: xizmatlar tgId
// ishlatadi, do'kon memberId — R4 auditda qayd etilgan nomuvofiqlik, yangi jadval to'g'ri tanlaydi).
model ProductFavorite {
  id        Int      @id @default(autoincrement())
  memberId  Int
  productId Int
  createdAt DateTime @default(now())

  @@unique([memberId, productId])
  @@index([memberId, createdAt])
}

model Product {
  id          Int      @id @default(autoincrement())
  shopId      Int? // 🏪 V1: qaysi MarketShop'niki (loose FK, ProductPhoto precedenti); null = hali migratsiyadan o'tmagan
  name        String
  description String?
  category    String   @default("umumiy") // free bucket: "oziq-ovqat" | "elektronika" | … (D1'da CategoryDef.slug'ga ko'chadi)
  priceTanga  Int // whole tanga only (1 tanga = 1 so'm)
  oldPriceTanga Int? // marketplace discount display: strikethrough + −N% badge (null = no discount)
  featured    Boolean  @default(false) // hero-carousel slot on the shop home
  stock       Int      @default(0) // remaining units — decrement is ATOMIC (updateMany stock>=1)
  photoFileId String? // Telegram file_id (durable) — driver-photo pattern
  photoUrl    String? // data-URL fallback / permanent override
  active      Boolean  @default(false) // created OFF; owner flips ON to list
  sortOrder   Int      @default(0)
  favCount    Int      @default(0) // 🧡 V2b: ❤ sevimlilar-hisoblagich (ServiceListing naqshi — viral signal)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([shopId, active]) // 🏪 V1: seller-scoped katalog so'rovlari
}

// 🖼 Product gallery — up to 5 photos per product ("real market feel": swipeable detail gallery).
// Same storage as the cover: Telegram file_id (durable) or data-URL fallback. Cover = first photo
// (legacy Product.photoFileId/photoUrl still serves as photo #0 when no gallery rows exist).
model ProductPhoto {
  id          Int     @id @default(autoincrement())
  productId   Int
  fileId      String?
  url         String?
  thumbFileId String? // ~320px Telegram size — card/mini/hero lists load this, NOT the full photo
  sortOrder   Int     @default(0)

  @@index([productId, sortOrder])
}

// 🗣 One review per member per product: 👍/👎 + optional text + up to 3 photos (Uzum pattern).
// Photos ride the same Telegram-file_id pipeline; photosJson = [{f: fileId, t: thumbFileId, u: dataUrl?}].
// Loose FK like ProductPhoto (no relation) — product delete cleans reviews in the service.
model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int
  memberId   Int
  thumb      String // "up" | "down"
  rating     Int?     // ⭐ V3.2: 1-5 (additiv — eski thumb-only sharhlar rating=null qolaveradi)
  text       String?
  photosJson String?
  tangaPaid  Boolean  @default(false) // V3.2: sharh-uchun-tanga BIR UMR to'langanmi (idempotent-belgi, kalit bilan bir qatorda)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, memberId]) // re-submit = edit, never a duplicate row
  @@index([productId, id])
}

// One shop purchase. Tanga is HELD at creation (CoinTxn key shop:<id> in the SAME tx as the stock
// decrement + order insert); rejected orders refund via grantCoins key shoprefund:<id> + restock.
// (Named ShopPurchase — a LEGACY "ShopOrder" model from the removed user-shops system still holds
// historical rows above and can't be renamed until the Phase-3 schema pass.)
model ShopPurchase {
  id          Int       @id @default(autoincrement())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int
  productId   Int
  productName String // snapshot — survives product edit/delete
  priceTanga  Int // snapshot — the price actually paid
  qty         Int       @default(1) // MVP: always 1
  payKind     String    @default("tanga") // "tanga" (buy'da ushlanadi) | "cash" (naqd — yetkazganda to'lanadi, coin ops YO'Q)
  address     String // delivery address
  contact     String // phone snapshot
  status      String    @default("pending") // pending | delivered | rejected | cancelled
  note        String? // owner's rejection reason (rider sees it)
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  slaAlertedAt DateTime? // 🏪 V1.5: seller 15 daqiqada javob bermasa egaga BIR marta alert (sweep-marker)

  @@index([memberId, status])
  @@index([status, createdAt])
}

// 🍽 RESTORAN (feature "restoran", RESTORAN_PLAN.md) — V1 = CONCIERGE: naqd/so'm to'lov (CoinTxn
// TEGILMAYDI, D1), operator restoranga telefon qiladi + holatni admin panelda qo'lda boshqaradi
// (D2/D3, orderChatId/bot-avtomatika V2'ga qoldirilgan). Shop patterni bilan bir xil (Product-uslub
// katalog + snapshot-order), yagona farq: ko'p-taomli savat (itemsJson).
model Restaurant {
  id             Int      @id @default(autoincrement())
  name           String
  category       String   @default("milliy") // milliy|fastfood|shirinlik|ichimlik|boshqa
  phone          String // operator shu raqamga qo'ng'iroq qiladi (V1 yagona aloqa kanali)
  address        String?
  workHours      String? // "09:00-22:00" — xizmatlar bilan bir xil Ochiq/Yopiq hisob (client-side)
  deliveryFeeSom Int      @default(0)
  minOrderSom    Int      @default(0)
  pickupEnabled  Boolean  @default(true)
  prepMinutes    Int      @default(30) // "taxminan N daqiqa" — operator checkout paytida ko'radi
  photoFileId    String? // Telegram file_id (durable) — shop/driver-photo patterni
  photoUrl       String? // data-URL fallback / permanent override
  active         Boolean  @default(false) // created OFF; admin flips ON to list (shop patterni)
  paused         Boolean  @default(false) // avto (V2: 3× expired) yoki operator so'rovi bilan
  sortOrder      Int      @default(0)
  avgRating      Float    @default(0)
  reviewCount    Int      @default(0)
  orderCount     Int      @default(0) // kelajak sotuv-quroli: "sizga N buyurtma keltirdik"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  menuItems      MenuItem[]
  reviews        RestaurantReview[]

  @@index([active, sortOrder])
}

// Menyu band — Product-uslub, lekin narx REAL SO'M (tanga emas, D1).
model MenuItem {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  section      String     @default("Taomlar") // "Salatlar" | "Issiq taom" | "Ichimlik" — erkin matn, guruhlash uchun
  name         String
  desc         String     @default("")
  priceSom     Int // REAL SO'M — tanga emas (D1)
  photoFileId  String?
  photoUrl     String?
  available    Boolean    @default(true) // "tugadi" — admin qo'lda o'chiradi (V1'da restoran o'zi kira olmaydi)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, section, sortOrder])
}

// Bitta buyurtma. Naqd to'lov (D1) — CoinTxn YO'Q, refund logikasi kerak emas. Holat operator
// tomonidan admin panelda qo'lda boshqariladi (concierge V1, RESTORAN_PLAN §0/§2).
model FoodOrder {
  id             Int       @id @default(autoincrement())
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  restaurantId   Int // loose (Product.productId patterni) — restoran o'chsa ham buyurtma tarixi qoladi
  itemsJson      Json // [{menuItemId, name, qty, priceSom}] — narx SNAPSHOT
  itemsTotalSom  Int
  deliveryFeeSom Int       @default(0)
  totalSom       Int
  isPickup       Boolean   @default(false)
  address        String
  contact        String
  note           String    @default("")
  status         String    @default("pending") // pending|accepted|preparing|delivering|delivered|rejected|cancelled_by_user
  rejectReason   String?
  calledAt       DateTime? // operator "restoranga qo'ng'iroq qildim" belgisi
  operatorId     Int? // qaysi admin/operator ishladi (javobgarlik izi)
  slaAlertedAt   DateTime? // R3 SLA-sweep: 3+ daqiqa pending — operator-eslatma BIR MARTA yuborildi
  acceptedAt     DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([restaurantId, status])
  @@index([memberId, createdAt])
  @@index([status, createdAt])
}

// 🗣 1 baho/sharh — 1 a'zo — 1 restoran (re-submit = tahrirlash, ServiceReview patterni). Restaurant
// avgRating/reviewCount CACHE qilingan (har submit'da qayta hisoblanadi — ro'yxat render'ida JOIN yo'q).
model RestaurantReview {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId Int
  memberId     Int
  stars        Int // 1-5
  text         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, memberId])
  @@index([restaurantId, id])
}

// Coin -> real so'm conversions (the ONLY place real money leaves the system).
model Withdrawal {
  id         Int      @id @default(autoincrement())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   Int
  amount     Float
  kasApplied Boolean  @default(false)
  kasMessage String?
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
}

// 💵 Real CASH-OUT request (tanga → plastik card / cash-to-home), settled MANUALLY by the owner.
// The full card number is NEVER persisted — only `mask` (•••• 1234) is stored; the real card goes
// solely into the owner's Telegram message. Tangas are spent ONLY when the owner taps «✅ To'landi»
// (spendCoinsIdempotent, key cashout:<id>) so a double-tap can't double-pay.
model CashoutRequest {
  id        Int       @id @default(autoincrement())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  amount    Int
  method    String // "card" | "home"
  mask      String // "•••• 1234" for a card, or the home address — safe to persist
  contact   String // phone
  status    String    @default("pending") // pending | paid | rejected
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([memberId, status])
  @@index([status, createdAt])
}

// Weekly engagement league: score accrues from bot actions (check-in, spin,
// missions, rides, referrals); top-3 of the closed week win real cashback.
model WeeklyScore {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  weekKey   String // ISO week, e.g. "2026-W24"
  score     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([memberId, weekKey])
  @@index([weekKey, score])
}

// Tiny global key-value state (jackpot pool, weekly-payout markers).
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// T7/T8 — local daily ride rollup (Tashkent day). Fed by the sync tick from kas's
// shallow-but-complete "today" window, so week-over-week / 7-day metrics come from
// our own DB instead of impractically deep kas paging (~1650 report rows/day).
model DailyStat {
  day            String   @id // YYYY-MM-DD (Tashkent, UTC+5)
  completedRides Int      @default(0)
  cancelledRides Int      @default(0)
  botRides       Int      @default(0)
  gmv            Float    @default(0) // gross fares (so'm) of completed rides
  updatedAt      DateTime @updatedAt
}

// Mystery box: free one unlocks by completing ALL daily missions (once/day);
// premium boxes are bought with coins, unlimited.
model BoxOpen {
  id        Int      @id @default(autoincrement())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  Int
  dayKey    String // tashkent day
  prize     String
  amount    Float    @default(0)
  premium   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memberId, dayKey])
}

// Every cashback we grant (idempotent + audited — this writes REAL money to kas1067).
model RewardGrant {
  id             Int      @id @default(autoincrement())
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  amount         Float // so'm granted
  reason         String // human label, e.g. "Streak 7 kun"
  kind           String // streak | wheel | challenge | referral | manual
  appliedToKas   Boolean  @default(false)
  kasMessage     String?
  idempotencyKey String?  @unique // blocks double-grants (e.g. "streak:42:2026-06-09")
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

model Streak {
  id          Int       @id @default(autoincrement())
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    Int       @unique
  current     Int       @default(0)
  longest     Int       @default(0)
  lastCheckIn DateTime? // last daily check-in (date)
  updatedAt   DateTime  @updatedAt
}

model TelegramUser {
  id                 String    @id // telegram user id, stored as string to avoid BigInt JSON issues
  member             Member?   @relation(fields: [memberId], references: [id])
  memberId           Int?      @unique
  username           String?
  firstName          String?
  lastName           String?
  phone              String?
  languageCode       String?
  isAdmin            Boolean   @default(false)
  linkedAt           DateTime?
  referralCode       String?   @unique // this user's own invite code
  referredByCode     String? // pending invite code captured at /start
  referralCreditedAt DateTime? // set once the referral reward is paid (one-time)
  blockedAt          DateTime? // set when a send returns 403 (user blocked the bot); cleared when they interact again
  lastSeenAt         DateTime? // TRUE last inbound interaction (set only by the presence middleware, throttled) — unlike updatedAt it is never bumped by background writes, so the admin "online" column is honest
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lastSeenAt])
}

model MemberAchievement {
  id       Int      @id @default(autoincrement())
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int
  code     String // badge code from the shared catalog
  earnedAt DateTime @default(now())
  notified Boolean  @default(false)

  @@unique([memberId, code])
}

model SyncRun {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String    @default("running") // running | ok | error
  source      String    @default("mock") // mock | live
  membersSeen Int       @default(0)
  message     String?
}

// 👬 Gap (o'zbekona jamoa): 3-6 do'st, haftalik jamoa maqsadi, rotatsion pot.
model Gap {
  id        Int         @id @default(autoincrement())
  name      String
  code      String      @unique
  creatorId Int
  potIndex  Int         @default(0)
  createdAt DateTime    @default(now())
  members   GapMember[]
}

model GapMember {
  id       Int      @id @default(autoincrement())
  gapId    Int
  memberId Int      @unique // one gap per member
  joinedAt DateTime @default(now())
  gap      Gap      @relation(fields: [gapId], references: [id])

  @@index([gapId])
}

// 🏢 B2B prepaid corp accounts: phone-whitelisted employees ride, balance prepaid in coins.
model CorpAccount {
  id                    Int            @id @default(autoincrement())
  name                  String
  balance               Float          @default(0)
  monthlyCapPerEmployee Int            @default(30)
  createdAt             DateTime       @default(now())
  employees             CorpEmployee[]
}

model CorpEmployee {
  id     Int         @id @default(autoincrement())
  corpId Int
  phone  String      @unique // last-9 normalized
  name   String?
  corp   CorpAccount @relation(fields: [corpId], references: [id])

  @@index([corpId])
}

// ⭐ E7: post-ride rating + quick tags ("Toza mashina")
model RideRating {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  carNumber String   @default("")
  stars     Int
  tags      String   @default("")
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([carNumber])
}

// 🤝 Virtual bozor v2: escrowed offers (coins and/or barter) + per-deal chat.
model TradeOffer {
  id          Int            @id @default(autoincrement())
  itemId      Int // target item being asked for
  fromId      Int // offerer (coins escrowed on create)
  toId        Int // current owner
  offerCoins  Int            @default(0)
  offerItemId Int? // barter: item offered in exchange
  status      String         @default("open") // open|accepted|rejected|cancelled
  createdAt   DateTime       @default(now())
  messages    TradeMessage[]

  @@index([toId, status])
  @@index([fromId, status])
}

model TradeMessage {
  id        Int        @id @default(autoincrement())
  offerId   Int
  fromId    Int
  text      String
  createdAt DateTime   @default(now())
  offer     TradeOffer @relation(fields: [offerId], references: [id])

  @@index([offerId])
}

// ⏰ I.2: scheduled rides — we hold them and dispatch via the periodic tick.
model ScheduledRide {
  id          Int      @id @default(autoincrement())
  memberId    Int
  addressId   Int
  addressName String
  phone       String
  runAt       DateTime
  status      String   @default("pending") // pending|dispatched|cancelled|failed
  createdAt   DateTime @default(now())

  @@index([status, runAt])
  @@index([memberId])
}

// 🔔 AI v2 P1: eslatmalar (feature "airemind"). Delivered by the EXISTING adaptive
// booking sweep (deliverDueReminders — no new poller), claim-before-send. Generic —
// NOT ride-specific (ScheduledRide stays the real-dispatch path). Text is the user's
// own words, echoed back verbatim at fire time (never regenerated by the LLM).
model Reminder {
  id         Int       @id @default(autoincrement())
  memberId   Int
  telegramId String    // delivery chat — ALWAYS the requester themselves (no third parties)
  kind       String    @default("oddiy") // oddiy | taksi | qarz
  text       String    // ≤120 chars, sanitized at create
  runAt      DateTime  // resolved by the LOCAL Uzbek time parser (never the LLM)
  recurrence String?   // P1 ships null only; P2: "daily" | "weekly:N"
  actionJson String?   // optional 1-tap payload, e.g. {"type":"book","query":"bozor"}
  status     String    @default("pending") // pending | sent | cancelled | failed
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([status, runAt])   // the sweep's due-query
  @@index([memberId, status]) // "eslatmalarim" list + pending cap
}

// 💛 Koson AI K4 (feature "aidost"): the assistant's own short notes about a member —
// THEIR OWN WORDS from conversation ("ertaga imtihoni bor"), recalled only into that
// member's next-turn context. Max 20/member (oldest evicted), erased on «meni unut».
// NEVER balances/phones — the agent tool only receives conversational facts. Not shown
// in any admin surface.
model MemberMemory {
  id        Int      @id @default(autoincrement())
  memberId  Int
  note      String   // ≤200 chars, sanitized
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

// 🧠 Koson AI jamoaviy bilim (feature "aibilim"). Odamlar Koson haqida fakt yozadi (/bilim),
// EGA tasdiqlaydi; tasdiqlangan faktlar AI system-prompt kontekstiga keyword-retrieval bilan
// kiradi. Bible §17.2 Business Registry urug'i. Pul YO'Q; PII emas — ommaviy shahar-bilimi.
model AiKnowledge {
  id          Int       @id @default(autoincrement())
  text        String // fakt, ≤500 belgi
  submittedBy String // telegramId (kim yubordi)
  status      String    @default("pending") // pending | approved | rejected
  moderatedBy String? // owner telegramId
  createdAt   DateTime  @default(now())
  moderatedAt DateTime?

  @@index([status, createdAt])
}

// 👨‍👩‍👧 I.3: family booking targets (max 3, validated at create).
model FamilyMember {
  id       Int    @id @default(autoincrement())
  memberId Int
  phone    String
  name     String

  @@unique([memberId, phone])
}

// ══ 🏆 GARAJ v2 — deep car-restoration game (gated by feature "garajx"; replaces idle garage) ══
// Follows the existing game-table convention: Int ids, plain `memberId Int` + @@index
// (like MemberCar) — no relation field on Member, no Member-model edit.

// 1:1 per-member garage meta. carsOwnedCount/sumCarLevels are DENORMALIZED so the
// reputation/score recompute never needs a COUNT/SUM on every ride (audit M2).
model MemberGarajMeta {
  memberId           Int       @id
  garageTier         Int       @default(1)
  reputationScore    Int       @default(0)
  prestigeCount      Int       @default(0)
  prestigeMultiplier Float     @default(1.0)
  kozachaBalance     Int       @default(0)
  carsOwnedCount     Int       @default(0)
  sumCarLevels       Int       @default(0)
  dreamCarCode       String?
  onboardStep        Int       @default(0)
  lastBoxCollectedAt DateTime?
  // 🌍 MOTOR OLAMI bonus-week (admin-tunable): stamped on first motor acquire when bonusDays>0;
  // while now < motorBonusUntilAt, getMotorEconFor applies bonus* multipliers on top of base econ.
  motorBonusUntilAt  DateTime?
  // 🏛 P1-A — scarcity slot system (default 1 active car; purchaseSlot → 50k/250k/1M)
  slotCount          Int       @default(1)
  // 🔍 P1-A — CarCheck: first Premium reveal is free (newbie protection, one-shot)
  carCheckFreeUsed   Boolean   @default(false)
  // ⭐ P1-A — seller reputation aggregate (xaridor rates 1-5 → updates these; rating = sum/count)
  sellerRatingSum    Int       @default(0)
  sellerRatingCount  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Per-car restoration project. One of each model per member (memberId+carCode unique).
model GarajCar {
  id                 Int       @id @default(autoincrement())
  memberId           Int
  carCode            String
  source             String    @default("shop") // shop | ride_drop | onboard
  condition          String    @default("worn") // worn | fair | good | mint
  diagnosisSeed      Int?
  diagnosisResult    String? // JSON zone breakdown (revealed by diagnosis)
  repairZones        String? // JSON CURRENT per-zone condition 0-100 (driven by repairZone)
  diagnosedAt        DateTime?
  style              String? // QUICK_FLIP | FULL_RESTORE | TUNING | PERIOD_CORRECT
  styleLockedAt      DateTime?
  level              Int       @default(1)
  repairQualityBonus Float     @default(1.0)
  acquireCost        Int       @default(0)
  repairSpent        Int       @default(0)
  ridesSinceService  Int       @default(0)
  onboardCar         Boolean   @default(false) // FTUE car — blocks the real flip endpoint
  soldAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ── 🌍 MOTOR OLAMI (v3, gated by feature "motorolami"; additive/non-destructive) ──
  // Noyob global #serial + tarix; mashina pul ishlaydi (speed→tanga, fuel/wear kunlik auto);
  // engineHp = wear holati (0-100); bornAt+lifespan = umr → o'lim. Speed/fuel/wear/umr CONFIG'dan.
  serial             Int?      @unique // global noyob #raqam (motorolami acquire'da beriladi)
  bornAt             DateTime? // umr hisobi boshlanishi (lifespan config'dan)
  engineHp           Int       @default(100) // dvigatel holati 0-100 (eyilish tushiradi; CarCheck ko'rsatadi)
  lastAccrualAt      DateTime? // oxirgi earn hisoblangani (accrue shu vaqtdan)
  ownerCount         Int       @default(1) // egalar soni (tarix)
  totalTrips         Int       @default(0) // jami safar (taksi 2× hooki)
  // 🔥 P-Fuel-A — Hay Day hook: manual fuel-fill (tank empties → push → user returns → refuel)
  fueledUntilAt      DateTime? // tank "runway end" — earn faqat shu vaqtgacha. now > this → dry → 0 net
  fuelRefillCount    Int       @default(0) // MUST NOT RESET on re-buy (audit-B1 pattern). Deterministic idempotency key tail.
  // 🏛 P1-A — Motor Olami P1 fields (lifespan + capital remont + hidden defect + Ofis-held)
  capitalRepairCount Int       @default(0) // immutable counter (RESTORE craft ++), feeds REPAIR_NARX_FACTOR resale clamp
  hiddenDefect       String?   // JSON {zone, severity} — 3% deterministic stamp on acquire; Premium CarCheck reveals
  ofisHeld           Boolean   @default(false) // true while 1067 Ofis owns the car (re-list / scrap pending)
  // 🔗 P2-A — merge mechanic counter; +1 per 2→1 fuse (sacrifice ANY car to promote this one);
  // bounded by MERGE_MAX_COUNT (anti-runaway). MUST NOT RESET on re-buy (audit-B1 pattern).
  mergeCount         Int       @default(0)
  // 🎁 P2-B — Jackpot variant (null=oddiy, "qora_nexia"=1%, "afsonaviy_tiko"=0.05%).
  // Deterministic from serial → re-buy doesn't change result (no grinding). RESET on re-buy
  // (a re-bought car gets a NEW serial → NEW variant roll).
  variant            String?
  // 🚀 P2-C — Speeder booster (10-day, admin-tuned ×3/×4 to speedMult). RESET on re-buy
  // (a re-bought car loses its speeder — re-purchase needed).
  speederUntilAt     DateTime?

  @@unique([memberId, carCode])
  @@index([memberId])
}

// Flip/sale archive. saleId is computed BEFORE the tx (audit B1) and anchors the
// idempotent grant key flip:{memberId}:{garajCarId}:{saleId}.
model GarajFlip {
  id             Int      @id @default(autoincrement())
  memberId       Int
  garajCarId     Int
  carCode        String
  saleId         String   @unique
  boughtForT     Int
  repairSpentT   Int
  soldForT       Int
  profitT        Int
  style          String
  buyerArchetype String
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

// Ride → game drop idempotency anchor + record. ONE row per (member, ride) so a
// sweep retry never re-rolls. NO coin emission here (the 350 clamp is untouched).
model GarajRideDrop {
  id        Int      @id @default(autoincrement())
  memberId  Int
  bookingId Int
  dropType  String // NONE | PART | TOWED_CAR
  dropCode  String   @default("")
  seed      Int      @default(0)
  status    String   @default("pending") // #4 TOWED_CAR offer lifecycle: pending | claimed | declined
  createdAt DateTime @default(now())

  @@unique([memberId, bookingId])
  @@index([memberId])
}

// 🏺 Ko'zacha ledger — the SECOND currency, earned ONLY from real rides (≤8/ride),
// spent in the Kozacha shop. Fully SEPARATE from CoinTxn (never flows into tanga).
// Balance is denormalized on MemberGarajMeta.kozachaBalance.
model KozachaTxn {
  id             Int      @id @default(autoincrement())
  memberId       Int
  amount         Int // + earn, - spend
  reason         String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([memberId, createdAt])
}

// 🔧 Mechanic skill — Usta-ko'z rank (diagnosis accuracy) + 4 specialization
// branches (XP accrues from repair/flip; tier derived from MECH_XP_TIERS).
model MemberMechanicSkill {
  memberId        Int      @id
  ustaKozRank     Int      @default(0) // 0..100, +1 per 3 diagnoses
  totalDiagnoses  Int      @default(0)
  muhandisXp      Int      @default(0) // engine
  kuzovchiXp      Int      @default(0) // body
  savdogarXp      Int      @default(0) // merchant
  kollektsionerXp Int      @default(0) // collector
  firstRepairDone Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// 🛒 W4 Bazaar — player-to-player car market. Anti-wash: 3% tax burn, price
// ceiling 3× base, self-trade blocked, claim-before-pay (status open→pending→sold).
model GarajBazaarListing {
  id         Int       @id @default(autoincrement())
  sellerId   Int
  garajCarId Int
  carCode    String
  askPrice   Int
  status     String    @default("open") // open | pending_payment | sold | cancelled | expired
  buyerId    Int?
  soldAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([status, expiresAt])
  @@index([sellerId, status])
  @@index([garajCarId, status])
}

// 🔨 W4 sealed-bid auction. Escrow at bid (one bid/bidder, no revision), anti-snipe
// (+5min if bid in last 5min), settle in the sweep: highest wins, losers refunded.
model GarajAuction {
  id           Int       @id @default(autoincrement())
  sellerId     Int
  garajCarId   Int
  carCode      String
  minBid       Int
  highBid      Int       @default(0) // display cache; settle uses max(bids) authoritatively
  highBidderId Int?
  status       String    @default("open") // open | settled | cancelled
  endsAt       DateTime
  createdAt    DateTime  @default(now())

  @@index([status, endsAt])
}

model GarajAuctionBid {
  id        Int      @id @default(autoincrement())
  auctionId Int
  bidderId  Int
  amount    Int // escrowed at bid time
  refunded  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([auctionId, bidderId]) // sealed-bid: one bid per bidder, no revision
  @@index([auctionId])
}

// 🔧 P2-deep-5 — Limited-event parts (detallar). HARD global mint-cap per partCode
// (Steam-skin economy): once the cap is hit OR the mint event is closed, NO more can ever
// be minted → existing parts only change hands on the P2P parts market → price climbs.
// Installed on a car → +earnBonusPct to THAT car's earn. The serial is a per-partCode
// global unique mint # (Twin Turbo #042 / 500). Counter lives in AppState mo:part:next:<code>.
model GarajPart {
  id             Int       @id @default(autoincrement())
  partCode       String // twin_turbo | nitro | sport_ecu (MOTOR_PARTS config)
  serial         Int // per-partCode global unique mint #
  ownerId        Int // current owner member
  installedCarId Int? // null = sitting in inventory; set = bolted onto this GarajCar
  status         String    @default("owned") // owned | installed | listed
  mintedAt       DateTime  @default(now())

  @@unique([partCode, serial]) // race-safe: two concurrent mints can't share a serial
  @@index([ownerId, status])
  @@index([installedCarId])
  @@index([partCode])
}

// 🛠 P2-deep-6 — Detal-bozori: player-to-player parts market. Money-safe mirror of the car
// bazaar — claim-before-pay (atomic open→pending_payment), 3% tax burn (anti-wash), self-trade
// blocked. Limited parts APPRECIATE (scarcity) so the price ceiling is generous; the tax + the
// self-trade block are the real anti-wash, not a tight cap. A sale TRANSFERS the part's ownerId
// (no tanga emission — pure redistribution + 3% burn → invariant-safe).
model GarajPartListing {
  id        Int       @id @default(autoincrement())
  sellerId  Int
  partId    Int
  partCode  String
  askPrice  Int
  status    String    @default("open") // open | pending_payment | sold | cancelled
  buyerId   Int?
  soldAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([sellerId, status])
  @@index([partId, status])
}

// 🔥 W5 Forgiving streak — daily ride streak with ONE "spare tire" freeze. Updated
// in the ride-finish sweep (one increment per Tashkent day). Milestone rewards are
// grantCoins (mission-style, OUTSIDE the 350/ride clamp) keyed by milestone+date.
model GarajStreak {
  memberId        Int      @id
  current         Int      @default(0)
  longest         Int      @default(0)
  lastRideDate    String? // YYYY-MM-DD Tashkent
  freezeAvailable Boolean  @default(false)
  freezeUsed      Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// 🏘 W5 Mahalla — neighbourhood clan (max 20). Weekly score is ride-time ×
// car-quality (NOT tanga) so it can never be coin-farmed. One mahalla per member.
model MahallaGroup {
  id          Int      @id @default(autoincrement())
  name        String
  code        String   @unique // 6-char invite slug
  founderId   Int
  weeklyScore Int      @default(0)
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([weeklyScore])
}

model MahallaGroupMember {
  id          Int      @id @default(autoincrement())
  groupId     Int
  memberId    Int      @unique // one mahalla per member (hard constraint)
  role        String   @default("MEMBER") // FOUNDER | MEMBER
  weekContrib Int      @default(0)
  joinedAt    DateTime @default(now())

  @@index([groupId])
}

// Weekly league result. Its presence IS the reset idempotency marker (no separate
// AppState key) — @@unique([groupId, weekKey]) makes a partial-reset crash-safe.
model MahallaWeeklyResult {
  id        Int      @id @default(autoincrement())
  groupId   Int
  weekKey   String
  rank      Int
  score     Int
  createdAt DateTime @default(now())

  @@unique([groupId, weekKey])
}

// 🏆 W5 Hall of Fame — permanent entry after Prestige 5, shown to all on the Museum.
model GarajHallOfFame {
  id            Int      @id @default(autoincrement())
  memberId      Int      @unique
  prestigeCount Int
  repAtEntry    Int
  createdAt     DateTime @default(now())
}

// 🏆 #8 Exhibition — weekly car show. One entry per member per week (a snapshot so it
// persists even if the car is sold); one vote per member per week (self-vote blocked).
// The top-voted entry of the closed week wins a bounded, idempotent prize (sweep-settled).
model GarajExhibitionEntry {
  id        Int      @id @default(autoincrement())
  memberId  Int
  weekKey   String
  carCode   String
  level     Int      @default(1)
  condition String   @default("good")
  votes     Int      @default(0) // denormalized vote count
  createdAt DateTime @default(now())

  @@unique([memberId, weekKey])
  @@index([weekKey])
}

model GarajExhibitionVote {
  id        Int      @id @default(autoincrement())
  entryId   Int
  voterId   Int
  weekKey   String
  createdAt DateTime @default(now())

  @@unique([voterId, weekKey]) // one vote per member per week
  @@index([entryId])
}

// #5 timed Workshop craft jobs. Exactly ONE in_progress per member = the shared craftsman
// slot (cross-car contention, the core tradeoff). settleCraftJobs (sweep) applies the effect
// once finishesAt passes; a paid speedup sets finishesAt=now. The single-slot rule is enforced
// in code inside withMemberLock (count in_progress == 0 before enqueue). status: in_progress | done.
model GarajCraftJob {
  id         Int      @id @default(autoincrement())
  memberId   Int
  garajCarId Int
  station    String
  cost       Int      @default(0)
  status     String   @default("in_progress")
  startedAt  DateTime @default(now())
  finishesAt DateTime
  createdAt  DateTime @default(now())

  @@index([memberId, status])
  @@index([status, finishesAt])
}

// 🏛 P1-A — 1067 Ofis korp-ledger: every market-maker action (buy/release/scrap) audited
// here, kept SEPARATE from CoinTxn so corp budget is not confused with player emission. The
// daily budget cap is enforced by aggregating amount per dayKey. status: held|relisted|scrapped.
model OfisLedger {
  id         Int      @id @default(autoincrement())
  kind       String // buy | release | scrap
  amount     Int      @default(0) // tanga moved (negative = spent, positive = recovered)
  carCode    String?
  refCarId   Int? // GarajCar.id at time of action (audit reference; may be deleted)
  dayKey     String // tashkent date — budget aggregation key
  status     String   @default("held") // held | relisted | scrapped
  createdAt  DateTime @default(now())

  @@index([dayKey, kind])
  @@index([refCarId])
}

// 💸 Bosqich 3 audit log for driver-self debt repayments through the bot. ONE row per attempt; the
// `status` column distinguishes the failure mode so a wedged row never silently passes (and the
// driver doesn't see the wrong total). The idempotencyKey ("debt:<memberId>:<nonce>") matches the
// CoinTxn key so a retry that already debited tanga doesn't double-charge.
//   pending      = tanga held, kas write not started (process crash window)
//   balance_ok   = addDriverPayment succeeded (kas balance +amount)
//   confirmed    = takeDebt succeeded too (kas balance applied to debt; the happy path)
//   stuck        = balance_ok but takeDebt failed → tanga stays gone, kas balance up but debt
//                  unchanged; driver can retry takeDebt manually or use the leftover balance
//   refunded     = addDriverPayment failed → CoinTxn reversed, member made whole
model DriverDebtPayment {
  id             Int      @id @default(autoincrement())
  memberId       Int
  carNumber      String
  amount         Int // so'm == tanga (1:1 internal)
  status         String   @default("pending")
  idempotencyKey String   @unique
  kasBalance     Int? // post-write kas balance, when known
  kasStatusCode  Int?
  errorNote      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([memberId, createdAt])
  @@index([status])
}

// 🔑 Driver-side kas creds. A driver logs into the bot ONCE via /driver_login (carNumber + SMS) —
// kas returns a long-lived secretKey that authenticates every /api/driverApp/* call. We store it
// AES-256-GCM-encrypted (key from env DRIVER_KEY_AES, NEVER in DB) so a DB leak alone can't
// impersonate drivers. revokedAt is set when the driver explicitly logs out or kas returns 401
// on a previously-good key; the row stays for audit.
model DriverSession {
  memberId     Int       @id // one session per member
  carNumber    String    @unique // also kas's identity key — used in every driver-app body
  encryptedKey String // hex(AES-256-GCM ciphertext)
  keyIv        String // hex(12-byte IV) — random per encryption
  keyTag       String // hex(16-byte auth tag) — GCM integrity
  lastLoginAt  DateTime  @default(now())
  revokedAt    DateTime?
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([carNumber])
  @@index([revokedAt])
}

model SupportMsg {
  id         Int      @id @default(autoincrement())
  telegramId String
  direction  String   // "in" | "out"
  text       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  shopId     Int? // C1: null = umumiy AI/support-chat (o'zgarishsiz); non-null = mijoz↔do'kon chat
  relayMsgId Int? // C1: sotuvchiga yuborilgan relay-DM'ning Telegram message_id'si (reply-routing uchun)

  @@index([telegramId, createdAt])
  @@index([shopId, telegramId])
}

// 📹 D2/S1: do'kon-hikoya (Instagram/Snapchat-uslub, 24 soatda yo'qoladi). Muddati tugashi —
// YANGI POLLER YO'Q, o'qish-vaqtida `expiresAt > now()` filtr (rejalashtirilgan job emas).
model ShopStory {
  id          Int      @id @default(autoincrement())
  shopId      Int
  videoFileId String?
  photoFileId String?
  caption     String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  viewCount   Int      @default(0)

  @@index([shopId, expiresAt])
}

model ShopStoryView {
  id       Int      @id @default(autoincrement())
  storyId  Int
  memberId Int
  viewedAt DateTime @default(now())

  @@unique([storyId, memberId])
}

// 📢 Persistent broadcast delivery log — the owner can ALWAYS see who a mass
// message did NOT reach (previously the failed list vanished on page refresh).
// Storage choice: one Broadcast row per send (counts always persisted) +
// BroadcastRecipient rows ONLY for the FAILED recipients (full list, forever).
// "Sent" recipients are stored as a count only — keeps rows bounded
// (broadcast to 5000 users with 30 blocks = 1 + 30 rows, not 5001).
model Broadcast {
  id          Int                  @id @default(autoincrement())
  createdAt   DateTime             @default(now())
  text        String
  segment     String // "all" | "linked" | "dormant"
  sentCount   Int
  failedCount Int
  totalCount  Int
  recipients  BroadcastRecipient[]
}

model BroadcastRecipient {
  id          Int       @id @default(autoincrement())
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId Int
  telegramId  String
  name        String
  phone       String?
  status      String // "sent" | "failed"

  @@index([broadcastId])
}

// ════════════════════════════════════════════════════════════════════════════
// 🚐 INTERCITY — nationwide shared-taxi (any province ↔ any province).
// ALL real-money fares live in *Som Int fields here — NEVER in CoinTxn / tanga
// wallet / grantRideCoins / the 350-per-ride clamp. Tanga only as a capped
// discount (IntercityBooking.tangaDiscount). Gated behind feature "intercity".
// ════════════════════════════════════════════════════════════════════════════

// Static city catalog (seeded, not user-generated). lat/lng for display only.
model IntercityCity {
  id         Int      @id @default(autoincrement())
  name       String   // Uzbek, e.g. "Qarshi"
  nameRu     String?  // Russian display
  regionCode String   // "qashqadarya" | "tashkent" | ...
  lat        Float    @default(0)
  lng        Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  originRoutes      IntercityRoute[]   @relation("RouteOrigin")
  destRoutes        IntercityRoute[]   @relation("RouteDest")
  originTrips       IntercityTrip[]    @relation("TripOrigin")
  destTrips         IntercityTrip[]    @relation("TripDest")
  stopEntries       IntercityRouteStop[]
  boardingBookings  IntercityBooking[] @relation("BookingBoarding")
  alightingBookings IntercityBooking[] @relation("BookingAlighting")

  @@unique([name, regionCode])
  @@index([regionCode])
  @@index([active])
}

// A corridor between two cities. Stored normalized (originCityId < destCityId) so
// A→B and B→A are ONE row; the actual direction lives on each IntercityTrip.
model IntercityRoute {
  id             Int      @id @default(autoincrement())
  originCity     IntercityCity @relation("RouteOrigin", fields: [originCityId], references: [id])
  originCityId   Int
  destCity       IntercityCity @relation("RouteDest", fields: [destCityId], references: [id])
  destCityId     Int
  defaultFareSom Int      @default(0) // per seat, owner-set
  commissionSom  Int      @default(0) // platform cut per booking, owner-set (0 in pilot)
  distanceKm     Int      @default(0) // informational
  durationMin    Int      @default(0) // informational
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stops       IntercityRouteStop[]
  trips       IntercityTrip[]
  enrollments IntercityDriverEnrollment[]

  @@unique([originCityId, destCityId])
  @@index([active])
}

// Intermediate boarding/alighting points along a corridor (mid-route pickup).
model IntercityRouteStop {
  id                Int      @id @default(autoincrement())
  route             IntercityRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId           Int
  city              IntercityCity @relation(fields: [cityId], references: [id])
  cityId            Int
  stopOrder         Int      // 0 = origin … N = destination
  fareFromOriginSom Int      @default(0)

  @@unique([routeId, cityId])
  @@index([routeId, stopOrder])
}

// A driver declares which corridors they serve (preference, NOT a trip).
model IntercityDriverEnrollment {
  id                     Int      @id @default(autoincrement())
  driver                 Member   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId               Int
  route                  IntercityRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId                Int
  carCapacity            Int      @default(4)
  preferredDepartureTime String?  // "08:00" Tashkent local, informational
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())

  @@unique([driverId, routeId])
  @@index([driverId])
  @@index([routeId])
}

// A single published trip for a specific date/time/direction.
model IntercityTrip {
  id            Int      @id @default(autoincrement())
  driver        Member   @relation("IntercityDriver", fields: [driverId], references: [id], onDelete: Cascade)
  driverId      Int
  route         IntercityRoute @relation(fields: [routeId], references: [id])
  routeId       Int
  // actual direction for THIS trip (route is normalized; trip is directional)
  originCity    IntercityCity @relation("TripOrigin", fields: [originCityId], references: [id])
  originCityId  Int
  destCity      IntercityCity @relation("TripDest", fields: [destCityId], references: [id])
  destCityId    Int
  scheduledAt   DateTime // planned departure (UTC; Tashkent local +5)
  carCapacity   Int      @default(4)
  bookedSeats   Int      @default(0) // ATOMIC: only via updateMany WHERE-guard (anti-overbooking)
  fareSom       Int      @default(0) // per seat, frozen at publish time
  commissionSom Int      @default(0) // per booking, frozen at publish time
  status        String   @default("OPEN") // OPEN|BOARDING|DEPARTED|COMPLETED|CANCELLED|EXPIRED
  note          String?  // driver note, e.g. "Konditsioner bor"
  waitNotified  Boolean  @default(false) // wait-list riders already pinged for this trip
  departedAt    DateTime? // server-stamped on → DEPARTED
  completedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings       IntercityBooking[]
  commissionDebt IntercityCommissionDebt?
  penalties      IntercityDriverPenalty[]

  @@index([status, scheduledAt])
  @@index([driverId, status])
  @@index([routeId, status, scheduledAt])
  @@index([originCityId, destCityId, status, scheduledAt])
}

model IntercityBooking {
  id              Int      @id @default(autoincrement())
  trip            IntercityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId          Int
  rider           Member   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId         Int
  seatsBooked     Int      @default(1)
  paymentMethod   String   @default("CASH") // CASH | PREPAY
  status          String   @default("CONFIRMED")
  // CONFIRMED|PREPAY_PENDING|RIDER_CANCELLED|RIDER_CANCELLED_LATE|CANCELLED_BY_DRIVER|CANCELLED_NO_PAYMENT|COMPLETED|REFUND_PENDING|REFUNDED
  agreedFareSom   Int      @default(0) // total fare at booking time (immutable)
  tangaDiscount   Int      @default(0) // tanga spent as discount (≤5000)
  prepaidSom      Int      @default(0) // 0 for CASH; set on owner prepay-confirm
  commissionSom   Int      @default(0) // frozen from trip at booking time
  boardingCity    IntercityCity? @relation("BookingBoarding", fields: [boardingCityId], references: [id])
  boardingCityId  Int?     // null = trip origin
  alightingCity   IntercityCity? @relation("BookingAlighting", fields: [alightingCityId], references: [id])
  alightingCityId Int?     // null = trip destination
  idempotencyKey  String   @unique // "ibooking:<riderId>:<tripId>"
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refund IntercityRefund?

  @@unique([riderId, tripId]) // one booking per rider per trip
  @@index([tripId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
}

// Owner-approved refunds for prepaid bookings (mirrors CashoutRequest flow).
model IntercityRefund {
  id             Int      @id @default(autoincrement())
  booking        IntercityBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId      Int      @unique
  refundSom      Int
  reason         String   // driver_cancel | rider_cancel_full | rider_cancel_partial | auto_expire
  status         String   @default("PENDING") // PENDING | SETTLED | WAIVED
  idempotencyKey String   @unique // "irefund_settle:<id>"
  settledAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([status, createdAt])
}

// Commission owed by a driver, recognized at trip COMPLETED. Separate ledger from
// the kas-company debt that /qarz writes — these two are NEVER conflated.
model IntercityCommissionDebt {
  id            Int      @id @default(autoincrement())
  driver        Member   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId      Int
  trip          IntercityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId        Int      @unique // one debt per trip (idempotent)
  commissionSom Int
  status        String   @default("PENDING") // PENDING | PAID | WAIVED
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([driverId, status])
  @@index([status, createdAt])
}

// Driver penalty for last-minute cancel / no-show. Accumulates; blocks new trips
// once pending total exceeds the cap.
model IntercityDriverPenalty {
  id         Int      @id @default(autoincrement())
  driver     Member   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId   Int
  trip       IntercityTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)
  tripId     Int?
  penaltySom Int
  reason     String
  status     String   @default("PENDING") // PENDING | WAIVED | SETTLED
  createdAt  DateTime @default(now())

  @@index([driverId, status])
}

// Rider wants a trip that doesn't exist yet (T6). Sweep matches new trips → push.
model IntercityWaitEntry {
  id          Int      @id @default(autoincrement())
  rider       Member   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  riderId     Int
  routeId     Int      // normalized route id
  desiredDate String   // "YYYY-MM-DD"
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([riderId, routeId, desiredDate])
  @@index([routeId, desiredDate])
}

// Admin-configured peak hours: drivers earn bonusTanga per completed ride in this window.
model PeakHour {
  id         Int      @id @default(autoincrement())
  label      String   // e.g. "Ertalab pik"
  startTime  String   // "HH:MM" in Tashkent time (UTC+5)
  endTime    String   // "HH:MM"
  bonusTanga Int      // tanga per ride during this window
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 📞 Obzvon: one call-list row per kas1067 driver. A sync mirrors the kas roster (kas-derived
// fields overwritten each sync) while PRESERVING the operator's call state (status/note/callback).
// No money here — pure CRM. inBot = does this driver's car match a linked bot Member.
model DriverCall {
  id          Int       @id @default(autoincrement())
  kasDriverId Int       @unique // external kas1067 driver id
  fullName    String    @default("")
  phone       String?
  carNumber   String?
  carModel    String?
  address     String?
  balance     Int       @default(0)
  debt        Int       @default(0)
  trips       Int       @default(0) // takeBookingCount (lifetime)
  rating      Float     @default(0)
  active      Boolean   @default(true) // kas active flag (blocked/disabled)
  lastRideAt  DateTime? // lastTakeBookingDate — recency drives "buyurtma olyapti?"
  licenseTerm DateTime?
  inBot       Boolean   @default(false) // car matches a linked bot driver Member
  // ── operator call state (survives every roster sync) ──
  status      String    @default("new") // new|called|no_answer|callback|interested|joined|refused|invalid
  note        String?
  callbackAt  DateTime? // scheduled call-back time (status=callback)
  calledAt    DateTime? // last time an operator logged a contact
  calledBy    String? // operator role/token that logged it
  callCount   Int       @default(0)
  syncedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([inBot, active])
}

// ── 🔎 XIZMATLAR (feature "xizmatlar", DARK) — Koson services directory ─────────────────────────
// "Koson 2GIS'i": every local business with phone/photos/rating/reviews. NO money paths — the
// coin ledger is untouched; the only writes are listings, counters and reviews.

model ServiceCategory {
  id        Int              @id @default(autoincrement())
  name      String
  emoji     String           @default("")
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  listings  ServiceListing[]
}

model ServiceListing {
  id          Int             @id @default(autoincrement())
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  name        String
  phone       String
  phone2      String?
  desc        String          @default("")
  tags        String          @default("") // "sement, g'isht, qurilish" — search field
  address     String?
  geoLat      Float? // «Borish» tugmasi → tashqi navigator deep-link (app ichida xarita shart emas)
  geoLng      Float?
  instagram   String? // ijtimoiy tarmoq havolalari — profilda ikon-tugma, faqat displey
  telegramUrl String?
  facebook    String?
  website     String?
  workHours   String? // "08:00-19:00" → UI computes Ochiq/Yopiq live
  status      String          @default("pending") // pending | active | rejected | archived
  isVip       Boolean         @default(false)
  verified    Boolean         @default(false) // blue badge — admin-granted only (identity/phone trust)
  // 🏅 «1067 TEKSHIRUVI» — MIJOZ BAHOSIDAN BUTUNLAY ALOHIDA: 1067 jamoasi jismoniy borib
  // tekshirgan rasmiy audit (toza joymi, xizmat sifati, narx-mos). `verified` shunchaki
  // telefon/identity ishonchi; bu esa SIFAT auditi. avgRating/reviewCount'ga HECH tegmaydi,
  // rankScore'ga ham qo'shilmaydi (mustaqil signal — ikkalasini aralashtirmaslik ataylab).
  // 100-ballik 5-mezonli standart (1067_TEKSHIRUVI_STANDARTLARI.pdf) — har biri 0-20 ball,
  // umumiy ball server-side hisoblanadi (shared/inspection.ts). 60dan past bo'lsa ommaviy
  // belgi UMUMAN chiqmaydi (kredibillikni himoya qiladi) — kod tomonda, saqlashda emas.
  inspClean   Int? // 🧼 Tozalik va sanitariya (0-20)
  inspProf    Int? // 👔 Professionalizm va muomala (0-20)
  inspPrice   Int? // 💰 Narx-sifat muvofiqligi (0-20)
  inspTrust   Int? // 📜 Ishonchlilik — manzil/telefon/litsenziya haqiqiyligi (0-20)
  inspQuality Int? // ⭐ Xizmat/mahsulot sifati (0-20)
  inspNote    String? // qisqa xulosa: "Toza, professional, narxlar mos"
  inspAt      DateTime? // tekshirilgan sana — audit natijasi o'zgarganda serverda avto-yangilanadi
  ownerTgId   BigInt? // who self-submitted (edit rights + spam cap)
  viewCount   Int             @default(0)
  callCount   Int             @default(0) // server-side only — "sizni N marta izlashdi" proof
  favCount    Int             @default(0) // ❤️ Like (=ServiceFavorite toggle) — OMMAVIY hisoblagich,
              // viral-ijtimoiy signal ("N kishi like bosgan, siz ham bosing") uchun. Bir xil
              // mexanizm (saqlash=like), faqat endi hammaga ko'rinadigan son bilan.
  phoneReports Int            @default(0) // "raqam ishlamadi" flags (1/user via AppState marker); ≥2 → admin recheck queue; reset on phone edit
  avgRating   Float           @default(0) // cached aggregate, recomputed on each review write
  reviewCount Int             @default(0) // cached aggregate
  rankScore   Float           @default(0) // bayes ranking cache: (avg*n + 4.0*5)/(n+5)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  photos      ServicePhoto[]
  reviews     ServiceReview[]
  prices      ServicePriceItem[]

  @@index([categoryId, status, rankScore])
  @@index([status, isVip])
  @@index([ownerTgId])
}

// 💰 Preyskurant (2GIS parity): "Soch olish — 25 000". Admin/egasi kiritadi; karta "N so'mdan"
// ko'rsatadi (min), profil to'liq ro'yxatni. Bu NARX KO'RSATISH xolos — hech qanday to'lov yo'li emas.
model ServicePriceItem {
  id        Int            @id @default(autoincrement())
  listing   ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId Int
  label     String // "Soch olish", "Sement (1 qop)"
  priceSom  Int // so'mda — faqat displey
  sortOrder Int            @default(0)

  @@index([listingId, sortOrder])
}

// 🔖 Saqlanganlar — foydalanuvchining shaxsiy ro'yxati (qayta-qaytish sababi). Pul yo'q.
model ServiceFavorite {
  id        Int      @id @default(autoincrement())
  tgId      BigInt
  listingId Int
  createdAt DateTime @default(now())

  @@unique([tgId, listingId])
  @@index([tgId, createdAt])
}

// Gallery — ProductPhoto pattern: Telegram file_id (durable, free) with data-URL fallback.
// thumbFileId = Telegram's ~320px tier for 52px card thumbs (~15-25KB vs 100-300KB full).
model ServicePhoto {
  id          Int            @id @default(autoincrement())
  listing     ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   Int
  fileId      String?
  thumbFileId String?
  url         String?
  sortOrder   Int            @default(0)

  @@index([listingId, sortOrder])
}

// 🔎 Demand capture: a search that found nothing (or a manual "menga X kerak") is RECORDED —
// the admin sees aggregated unmet demand and recruits exactly those businesses. Zero money.
model ServiceRequest {
  id        Int      @id @default(autoincrement())
  tgId      BigInt
  query     String // what the user was looking for
  note      String   @default("") // optional detail ("tungi ishlaydigan bo'lsin")
  status    String   @default("new") // new | done | dismissed
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ServiceReview {
  id         Int            @id @default(autoincrement())
  listing    ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  Int
  tgId       BigInt // Telegram-auth author — 1 user = 1 review per listing (upsert)
  authorName String
  stars      Int // 1..5
  text       String         @default("")
  status     String         @default("visible") // visible | hidden | reported
  reports    Int            @default(0) // 3 reports → auto-hidden + moderation queue
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([listingId, tgId])
  @@index([listingId, status, createdAt])
  @@index([status])
}

// 📋 E'LONLAR (feature "elonlar", ELONLAR_PLAN.md) — mahalla e'lon taxtasi (OLX-uslub). Har e'lon
// pending'da tug'iladi, faqat admin ✅'dan keyin xalqqa ko'rinadi (E3 moderatsiya). Joylash pullik
// (tanga, knob elonPostPrice) — CoinTxn idempotencyKey `elon_post_<adId>` bilan; rad etilsa
// `elon_refund_<adId>` bilan bir marta avto-qaytariladi (E2).
model ClassifiedAd {
  id         Int       @id @default(autoincrement())
  tgId       BigInt // egasi (edit/delete huquqi + spam-cap) — payment uchun memberId submit vaqtida getMemberId orqali resolve qilinadi
  authorName String
  category   String // oldi_sotdi | ish | yoqoldi | uyjoy | transport
  subtype    String // sotaman|olaman / beraman|izlayman / yoqoldi|topildi / ijara|sotuv / mashina|molhol
  title      String
  desc       String    @default("")
  priceSom   Int? // null = "Kelishiladi"; yoqoldi'da doim null
  phone      String
  status     String    @default("pending") // pending | active | sold | rejected | archived | expired
  isTop      Boolean   @default(false) // tanga-boost, 24 soat (E4)
  topUntil   DateTime?
  paidCoins  Int       @default(0) // joylash uchun to'langan tanga (0 = bepul davr yoki yoqoldi)
  viewCount  Int       @default(0) // cache — haqiqiy manba AdView
  callCount  Int       @default(0) // cache — haqiqiy manba AdContact
  reports    Int       @default(0) // 3 ta → auto-hide + moderatsiya navbati (E3)
  expiresAt  DateTime // createdAt + 30 kun
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  photos     AdPhoto[]
  reactions  AdReaction[]

  @@index([category, status, isTop, createdAt])
  @@index([tgId])
  @@index([status, expiresAt])
}

// 👍👎 E'lon reaksiyasi (ServiceReview naqshi): like = bitta tegish; dislike EGASIGA foydali bo'lishi
// uchun sabab-izoh talab qiladi (bo'sh dislike qabul qilinmaydi). 1 user = 1 reaksiya/e'lon (upsert —
// like<->dislike almashtirish yoki qayta bosib olib tashlash mumkin).
model AdReaction {
  id         Int          @id @default(autoincrement())
  ad         ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId       Int
  tgId       BigInt
  authorName String
  kind       String // like | dislike
  comment    String       @default("") // dislike uchun majburiy (>=3 belgi, server tekshiradi)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([adId, tgId])
  @@index([adId, kind])
}

// ServicePhoto pattern: Telegram file_id (durable, tekin) with data-URL fallback.
model AdPhoto {
  id        Int          @id @default(autoincrement())
  ad        ClassifiedAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      Int
  fileId    String?
  thumbFileId String?
  url       String?
  sortOrder Int          @default(0)

  @@index([adId, sortOrder])
}

// KIM ko'rdi — admin nazorat uchun (Mini App Telegram-auth = har viewer tgId ma'lum). E3 jadvalida ro'yxat ko'rinadi.
model AdView {
  id         Int      @id @default(autoincrement())
  adId       Int
  tgId       BigInt
  viewerName String   @default("")
  at         DateTime @default(now())

  @@unique([adId, tgId]) // 1 user = 1 view satri (qayta ochsa at yangilanadi)
  @@index([adId, at])
}

// KIM tel qildi / yozdi — "📞" yoki "✍️" bosilganda log
model AdContact {
  id         Int      @id @default(autoincrement())
  adId       Int
  tgId       BigInt
  viewerName String   @default("")
  kind       String // call | message
  at         DateTime @default(now())

  @@index([adId, at])
}

// 🏠 HOME FEED curation (feature "newhome"/"homeadmin", UY_REDESIGN Bosqich 3). Owner-curated promo
// banner + pinned dish/product for the premium home. EMPTY = the auto feed (top-seller/rating) runs —
// this only overrides/pins on top. Additive table (safe db:push).
model HomeFeatured {
  id        Int       @id @default(autoincrement())
  kind      String // "banner" | "product" | "restaurant"
  refId     Int? // pinned product/restaurant id (null for a pure banner)
  imageKey  String? // banner image path override (else the ref's own photo)
  title     String
  subtitle  String?
  target    String? // deep-link tab: dokon | restoran | ...
  badge     String?
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  region    String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([active, sortOrder])
}
