# ─── Telegram ────────────────────────────────────────────────
# Get a token from @BotFather. Without it the API still runs but the bot stays off.
BOT_TOKEN=
# Public URL of the Mini App (Vite dev = http://localhost:5173). Shown in the bot's "Open" button.
TELEGRAM_WEBAPP_URL=http://localhost:5173
# Comma-separated Telegram user ids allowed into the admin dashboard.
ADMIN_TELEGRAM_IDS=

# ─── Taxi dispatch ───────────────────────────────────────────
# mock   = offline demo data (development, simulators)
# birjoy = our own taxi core (1067-taxi API) — production. kas1067 ("live") was removed 2026-09-17.
KAS_MODE=mock
KAS_BIRJOY_URL=http://127.0.0.1:4000/api/v1
# Must equal the taxi core's SERVICE_TOKEN; a deployed bot refuses to start without it.
KAS_SERVICE_TOKEN=

# ─── Server / DB ─────────────────────────────────────────────
PORT=8080
PUBLIC_API_URL=http://localhost:8080
SYNC_INTERVAL_MINUTES=15
DATABASE_URL="file:./dev.db"
