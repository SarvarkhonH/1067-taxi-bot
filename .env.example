# ─── Telegram ────────────────────────────────────────────────
# Get a token from @BotFather. Without it the API still runs but the bot stays off.
BOT_TOKEN=
# Public URL of the Mini App (Vite dev = http://localhost:5173). Shown in the bot's "Open" button.
TELEGRAM_WEBAPP_URL=http://localhost:5173
# Comma-separated Telegram user ids allowed into the admin dashboard.
ADMIN_TELEGRAM_IDS=

# ─── kas1067 data source ─────────────────────────────────────
KAS_BASE_URL=http://46.8.176.53/kas1067
# Leave KAS_MODE=mock until you have credentials. Set to "live" once username/password are filled in.
KAS_MODE=mock
KAS_USERNAME=
KAS_PASSWORD=
# Path of the JSON endpoint that returns drivers/bonuses (discovered after login). Optional until known.
KAS_DRIVERS_PATH=

# ─── Server / DB ─────────────────────────────────────────────
PORT=8080
PUBLIC_API_URL=http://localhost:8080
SYNC_INTERVAL_MINUTES=15
DATABASE_URL="file:./dev.db"
